name: array initialiser expressions
expect: pass
stop: lir
errors: 0

[source]
fn int64[4] all() {
    return {1, 2, 3, 4};
}

fn int64[4] partial() {
    return {1, 2};
}

fn int64[4] empty() {
    return {};
}

fn int64[2][2] nested() {
    return {{1, 2}, {3, 4}};
}

[lir]
all:
    block0:
        %0 = zero
        %1 = insert %0, $0, 4
        %2 = insert %1, $8, 1
        %3 = insert %2, $16, 2
        %4 = insert %3, $24, 3
        %5 = insert %4, $32, 4
        return %5

partial:
    block0:
        %0 = zero
        %1 = insert %0, $0, 4
        %2 = insert %1, $8, 1
        %3 = insert %2, $16, 2
        return %3

empty:
    block0:
        %0 = zero
        %1 = insert %0, $0, 4
        return %1

nested:
    block0:
        %0 = zero
        %1 = insert %0, $0, 2
        %2 = zero
        %3 = insert %2, $0, 2
        %4 = insert %3, $8, 1
        %5 = insert %4, $16, 2
        %6 = insert %1, $8, %5
        %7 = zero
        %8 = insert %7, $0, 2
        %9 = insert %8, $8, 3
        %10 = insert %9, $16, 4
        %11 = insert %6, $32, %10
        return %11