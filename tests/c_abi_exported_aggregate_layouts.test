name: C callers exercise nested, union, and packed aggregate ABI layouts in Coda
expect: pass
stop: run
errors: 0

[source]
type Inner = struct {
    float64 value;
};
type NestedMixed = struct {
    int64 count;
    Inner inner;
};
type Choice = union {
    int64 integer;
    float64 real;
};
@packed type Packed = struct {
    uint8 tag;
    int64 value;
};

@export
fn NestedMixed coda_abi_nested_mixed(mut NestedMixed value) {
    value.count = value.count + 2;
    value.inner.value = value.inner.value + 2.5;
    return value;
}
@export
fn Choice coda_abi_union_integer(mut Choice value) {
    value.integer = value.integer + 5;
    return value;
}
@export
fn Packed coda_abi_packed_roundtrip(mut Packed value) {
    value.tag = value.tag + 1;
    value.value = value.value + 10;
    return value;
}

[c_source]
#include <stdint.h>
typedef struct { double value; } Inner;
typedef struct { int64_t count; Inner inner; } NestedMixed;
typedef union { int64_t integer; double real; } Choice;
typedef struct __attribute__((packed)) { uint8_t tag; int64_t value; } Packed;

extern NestedMixed coda_abi_nested_mixed(NestedMixed value);
extern Choice coda_abi_union_integer(Choice value);
extern Packed coda_abi_packed_roundtrip(Packed value);

int main(void) {
    NestedMixed nested = {10, {1.5}};
    NestedMixed nested_result = coda_abi_nested_mixed(nested);
    if (nested_result.count != 12 || nested_result.inner.value != 4.0) return 1;

    Choice choice = {.integer = 40};
    Choice choice_result = coda_abi_union_integer(choice);
    if (choice_result.integer != 45) return 2;

    Packed packed = {7, 1000};
    Packed packed_result = coda_abi_packed_roundtrip(packed);
    if (packed_result.tag != 8) return 3;
    if (packed_result.value != 1010) return 4;
    return 0;
}
