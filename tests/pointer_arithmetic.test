name: pointer arithmetic
expect: pass
stop: lir
errors: 0

[source]
fn int64 get(int64 *values, int64 i) {
    return *(values + i);
}

fn int64 get_back(int64 *values, int64 i) {
    return *(values - i);
}

fn int64 distance(int64 *a, int64 *b) {
    return a - b;
}

fn int64 get_commutative(int64 *values, int64 i) {
    return *(i + values);
}

fn int64 literal(int64 *p) {
    return *(p + 1);
}

fn int64 unsigned_index(int64 *p, uint64 i) {
    return *(p + i);
}

[lir]
