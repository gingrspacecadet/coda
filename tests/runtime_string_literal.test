[source]
@extern
fn int64 write(int64 fd, uint8* data, uint64 count);

uint8[] greeting = "hello\n";

fn int64 main() {
    uint8[] local = "Coda\n";
    write(1, greeting.ptr, greeting.len);
    write(1, local.ptr, local.len);
    return 0;
}

