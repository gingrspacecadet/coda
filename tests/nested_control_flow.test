        %5 = gt %1, 0
        branch %5, block2, block3(%1, %2)

    block2:
        %6 = gt %1, 5
        branch %6, block4, block5

    block3(%3, %4):
        return %4

    block4:
        %7 = add %2, 2
        jump block6(%1, %7)

    block5:
        %8 = add %2, 1
        jump block6(%1, %8)

    block6(%9, %10):
        %11 = sub %9, 1
        jump block1(%11, %10)