name: nested control flow
expect: pass
stop: lir
errors: 0

[source]
fn int64 nested(mut int64 value) {
    mut int64 result = 0;

    while (value > 0) {
        if (value > 5) {
            result = result + 2;
        } else {
            result = result + 1;
        }

        value = value - 1;
    }

    return result;
}

