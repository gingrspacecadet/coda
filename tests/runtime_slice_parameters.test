[source]
fn int64 get(int64[] values, int64 i) {
    return values[i];
}

fn none set(mut int64[] values, int64 i, int64 value) {
    values[i] = value;
    return;
}

fn int64 get_pointer(int64[] *values, int64 i) {
    return values[i];
}

fn none set_pointer(mut int64[] *values, int64 i, int64 value) {
    values[i] = value;
    return;
}

fn int64 main() {
    mut int64[3] values = {10, 20, 30};
    mut int64[] view = {3, values.ptr};

    set(view, 1, 42);
    set_pointer(&view, 2, 73);

    return get(view, 1) + get_pointer(&view, 2);
}

