type Values = int64[4];
type Matrix = int64[4][4];

fn int64 get(Values values, int64 i) {
    return values[i];
}

fn none set2(mut Matrix matrix, int64 i, int64 j, int64 value) {
    matrix[i][j] = value;
    return;
}

fn none set(mut Values values, int64 i, int64 value) {
    values[i] = value;
    return;
}

fn none set_constant(mut Values values, int64 value) {
    values[2] = value;
    return;
}

