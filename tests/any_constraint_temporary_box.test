name: constrained any boxes temporary return values
expect: pass
stop: run
errors: 0

[source]
constraint Readable = {
    fn uint64 Readable.read(Readable *self);
}

type File = struct {
    uint64 size;
};

fn uint64 File.read(File *self) {
    return self.size;
}

fn File make_file() {
    return {42};
}

fn uint64 read(any<Readable> file) {
    return file.read();
}

fn int64 main() {
    if (read(make_file()) != 42) return 1;
    return 0;
}

[stdout]

[stderr]

[exit]
0
