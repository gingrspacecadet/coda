[source]
fn bool equal(int64 *a, int64 *b) {
    return a == b;
}

fn bool not_equal(int64 *a, int64 *b) {
    return a != b;
}

fn bool less(int64 *a, int64 *b) {
    return a < b;
}

fn bool less_equal(int64 *a, int64 *b) {
    return a <= b;
}

fn bool greater(int64 *a, int64 *b) {
    return a > b;
}

fn bool greater_equal(int64 *a, int64 *b) {
    return a >= b;
}

