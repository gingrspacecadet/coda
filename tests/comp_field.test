name: compile-time field access
expect: pass
stop: lir
errors: 0

[source]
type Point = struct {
    int64 x;
    int64 y;
};

fn int64 test() {
    mut Point p = {
        .x = 10,
        .y = 20,
    };

    p.x = 30;
    return p.x + p.y;
}

fn int64 test2() {
    mut int64[3] values = {10, 20, 30};

    values[1] = 42;
    return values[0] + values[1] + values[2];
}

int64 x = $test();
int64 x2 = $test2();

[lir]
global @x:
    $0 = 50
global @x2:
    $0 = 82
test:
    block0:
        %0 = zero
        %1 = insert %0, $0, 10
        %2 = insert %1, $8, 20
        %3 = insert %2, $0, 30
        %4 = extract %3, $0
        %5 = extract %3, $8
        %6 = add %4, %5
        return %6

test2:
    block0:
        %0 = zero
        %1 = insert %0, $0, 3
        %2 = insert %1, $8, 10
        %3 = insert %2, $16, 20
        %4 = insert %3, $24, 30
        %5 = insert %4, $16, 42
        %6 = extract %5, $8
        %7 = extract %5, $16
        %8 = add %6, %7
        %9 = extract %5, $24
        %10 = add %8, %9
        return %10