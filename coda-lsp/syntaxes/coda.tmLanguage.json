{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "coda",
    "patterns": [
        {
            "include": "#imports"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#generics"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#intrinsics"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#types"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "imports": {
            "patterns": [
                {
                    "comment": "Scopes the import line, allowing internal tokens like :: and = to be colored individually",
                    "begin": "^\\s*(include|module)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.coda"
                        }
                    },
                    "end": "(?=;|//|$)",
                    "patterns": [
                        {
                            "name": "punctuation.separator.double-colon.coda",
                            "match": "::"
                        },
                        {
                            "name": "punctuation.separator.equal.coda",
                            "match": "="
                        },
                        {
                            "name": "entity.name.namespace.coda",
                            "match": "\\b[A-Za-z_]\\w*\\b"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.coda",
                    "match": "\\b(if|else|while|for|break|continue|fn|return|mut|struct|union|enum|type|constraint|defer|match|unsafe|module|include|\\$)\\b"
                },
                {
                    "name": "support.type.primitive.coda",
                    "match": "\\b(none|bool|u?int(8|16|32|64)|usize|ssize|float(16|32|64)|any|w?char|w?string)\\b"
                },
                {
                    "name": "constant.language.boolean.coda",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.coda",
                    "match": "\\b(null)\\b"
                },
                {
                    "name": "constant.language.this.coda",
                    "match": "\\b(this)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.coda",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.coda",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.coda",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.coda",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "generics": {
            "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(::)",
            "captures": {
                "1": {
                    "name": "entity.name.type.parameter.coda"
                },
                "2": {
                    "name": "punctuation.separator.double-colon.coda"
                }
            }
        },
        "functions": {
            "name": "entity.name.function.coda",
            "match": "\\b(?:[a-z_]\\w*\\s*(?=\\(|<\\s*([A-Z](?![A-Z])|none|u?int(8|16|32|64)|float(16|32|64)|bool|usize|ssize|char|string))|[A-Z]\\w*\\s*(?=\\())"
        },
        "namespaces": {
            "comment": "Handles inline namespace resolution like io::println",
            "match": "\\b([A-Za-z_]\\w*)(?=::)",
            "captures": {
                "1": {
                    "name": "entity.name.namespace.coda"
                }
            }
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.coda",
                    "match": "\\b\\d+(?:_\\d+)*\\.\\d+(?:_\\d+)*(?:[eE][+-]?\\d+(?:_\\d+)*)?[fF]?\\b"
                },
                {
                    "name": "constant.numeric.float.coda",
                    "match": "\\b\\d+(?:_\\d+)*[eE][+-]?\\d+(?:_\\d+)*[fF]?\\b"
                },
                {
                    "name": "constant.numeric.float.leading-dot.coda",
                    "match": "\\b\\.\\d+(?:_\\d+)*(?:[eE][+-]?\\d+(?:_\\d+)*)?[fF]?\\b"
                },
                {
                    "name": "constant.numeric.hex.coda",
                    "match": "\\b0x[0-9A-Fa-f]+(?:_[0-9A-Fa-f]+)*\\b"
                },
                {
                    "name": "constant.numeric.binary.coda",
                    "match": "\\b0b[01]+(?:_[01]+)*\\b"
                },
                {
                    "name": "constant.numeric.octal.coda",
                    "match": "\\b0o[0-7]+(?:_[0-7]+)*\\b"
                },
                {
                    "name": "constant.numeric.integer.coda",
                    "match": "\\b\\d+(?:_\\d+)*(?:[eE]\\d+)?([uU])?\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.other.unit.suffix.integer.coda"
                        }
                    }
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.double-colon.coda",
                    "match": "::"
                },
                {
                    "name": "punctuation.separator.colon.coda",
                    "match": ":"
                },
                {
                    "name": "punctuation.separator.comma.coda",
                    "match": ","
                },
                {
                    "name": "punctuation.access.pointer.coda",
                    "match": "->"
                },
                {
                    "name": "punctuation.access.dot.coda",
                    "match": "\\."
                },
                {
                    "name": "punctuation.terminator.semicolon.coda",
                    "match": ";"
                },
                {
                    "name": "storage.modifier.pointer.coda",
                    "match": "\\*(\\?)?"
                },
                {
                    "name": "keyword.operator.address-of.coda",
                    "match": "&"
                },
                {
                    "name": "keyword.operator.optional.coda",
                    "match": "\\?"
                },
                {
                    "name": "punctuation.definition.typeparameters.coda",
                    "match": "[<>]"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.coda",
                    "match": "//.*"
                },
                {
                "name": "comment.block.coda",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.begin"
                        }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.end"
                        }
                    }
                }
            ]
        },
        "intrinsics": {
            "patterns": [
                {
                    "name": "keyword.operator.expression.coda",
                    "match": "#[a-zA-Z_]\\w*"
                },
                {
                    "name": "keyword.control.coda",
                    "match": "#(?=[{(])"
                }
            ]
        },
        "attributes": {
            "name": "storage.modifier.coda",
            "match": "@[a-zA-Z_]\\w*(\\([\\(]*\\))?"
        },
        "constants": {
            "name": "variable.other.constant.coda",
            "match": "\\b_*[A-Z][A-Z0-9_]+\\b"
        },
        "types": {
            "name": "entity.name.type.coda",
            "match": "\\b_*[A-Z](?![A-Z0-9_]+\\b)\\w*\\b"
        },
        "variables": {
            "name": "variable.coda",
            "match": "\\b[a-z_]\\w*\\b"
        }
    },
    "scopeName": "source.coda"
}