{
    "scopeName": "source.coda",
    "patterns": [
        {
            "comment": "comments",
            "patterns": [
                {
                    "name": "comment.line.coda",
                    "match": "//.*"
                },
                {
                    "name": "comment.block.coda",
                    "begin": "/\\*",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.begin.coda"
                        }
                    },
                    "end": "\\*/",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.end.coda"
                        }
                    }
                }
            ]
        },
        {
            "comment": "imports",
            "begin": "^\\s*(include|module)\\b",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.coda"
                }
            },
            "end": "(?=;|$|//|/\\*)",
            "patterns": [
                {
                    "name": "punctuation.separator.coda",
                    "match": "(::|:)"
                },
                {
                    "name": "constant.language.import.all.coda",
                    "match": "\\b(_)\\b"
                },
                {
                    "name": "entity.name.namespace.coda",
                    "match": "\\b([A-Za-z_]\\w*)\\b"
                }
            ]
        },
        {
            "comment": "keywords",
            "patterns": [
                {
                    "name": "keyword.control.coda",
                    "match": "\\b(if|else|while|for|break|continue|return|defer|match)\\b"
                },
                {
                    "name": "keyword.other.coda storage.type.coda",
                    "match": "\\b(fn|type|constraint|struct|union|enum)\\b"
                },
                {
                    "name": "keyword.other.coda storage.modifier.coda",
                    "match": "\\b(mut)\\b"
                },
                {
                    "name": "constant.language.coda",
                    "match": "\\b(true|false|null)\\b"
                },
                {
                    "name": "variable.language.coda",
                    "match": "\\b(this)\\b"
                },
                {
                    "name": "support.type.primitive.coda",
                    "match": "\\b(none|bool|u?int(8|16|32|64)?|[us]size|float(16|32|64)|any|w?(char|string))\\b"
                }
            ]
        },
        {
            "comment": "numbers",
            "name": "constant.numeric.coda",
            "match": "\\b(-?(0[bB][01_]+|0[oO][0-7_]+|0[xX][0-9a-fA-F_]+)|[0-9_]+(.[0-9_]+)?([eE][+-]?[0-9_]+)?)\\b"
        },
        {
            "comment": "strings",
            "patterns": [
                {
                    "name": "string.quoted.double.coda",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.coda",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.coda",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.coda",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        {
            "comment": "intrinsics",
            "name": "constant.language.intrinsic.coda",
            "match": "(#[a-zA-Z_]\\w*)"
        },
        {
            "comment": "attributes",
            "name": "storage.modifier.attribute.coda",
            "match": "(@[a-zA-Z_]\\w*)"
        },
        {
            "comment": "namespaces",
            "match": "\\b([A-Za-z_]\\w*)(?=::)",
            "captures": {
                "1": {
                    "name": "entity.name.namespace.coda"
                }
            }
        },
        {
            "comment": "types",
            "name": "entity.name.type.coda",
            "match": "\\b_*[A-Z](?![A-Z0-9_]+\\b)\\w*\\b"
        },
        {
            "comment": "constants",
            "name": "variable.other.constant.coda",
            "match": "\\b_*[A-Z][A-Z0-9_]+\\b"
        },
        {
            "comment": "functions",
            "name": "entity.name.function.coda",
            "match": "\\b(?:[a-z_]\\w*\\s*(?=\\(|<\\s*([A-Z](?![A-Z_])|none|bool|u?int(8|16|32|64)?|[us]size|float(16|32|64)|any|w?(char|string))))"
        },
        {
            "comment": "variables",
            "name": "variable.coda",
            "match": "\\b[a-z_]\\w*\\b"
        },
        {
            "comment": "symbols",
            "patterns": [
                {
                    "name": "punctuation.separator.coda",
                    "match": "(\\.|,|:|::)"
                },
                {
                    "name": "punctuation.terminator.statement.coda",
                    "match": "(;)"
                },
                {
                    "name": "storage.modifier.pointer.coda",
                    "match": "\\*"
                },
                {
                    "name": "keyword.operator.arithmetic.coda",
                    "match": "(\\+|-|/|%)"
                },
                {
                    "name": "keyword.operator.comparison.coda",
                    "match": "(==|!=|<=|<|>=|>)"
                },
                {
                    "name": "keyword.operator.logical.coda",
                    "match": "(!&|!\\||!\\^|!|&&|\\|)"
                },
                {
                    "name": "keyword.operator.bitwise.coda",
                    "match": "(<<|>>|~&|~\\||~\\^|~|&|\\||\\^)"
                },
                {
                    "name": "keyword.control.comptime.coda",
                    "match": "\\$"
                },
                {
                    "name": "keyword.operator.bubble.coda",
                    "match": "(\\?)"
                }
            ]
        }
    ]
}