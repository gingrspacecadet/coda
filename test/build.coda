module build;

include core::build;
include std::fs;
include std::path;
include std::string;

@entry
fn int main() {
    fs::mkdirs("build");

    string[] sources = fs::glob("src/*.coda");

    for (uint i = 0; i < sources.len; i = i + 1) {
        string src = sources[i];

        string name = path::stem(src);
        string out = path::join({"build", name + ".o"});

        if (build::needs_rebuild(out, {src})) {
            let cmd = build::command("coda");

            cmd.args({
                src,
                "-o",
                out
            });

            if (!cmd.run()) {
                return 1;
            }
        }
    }

    return 0;
}