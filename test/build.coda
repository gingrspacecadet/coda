module build;

include std::build;

fn none main() {
    Build build = Build.create();

    Config debug = build.config("debug")
        .coda_backend("native")
        .coda_flags("-g")
        .coda_flags("-O0");

    Config release = build.config("release")
        .coda_backend("llvm")
        .coda_flags("-O3");

    Target app = build.executable("app")
        .sources("src/**/*.coda")
        .exclude("src/experimental.coda")
        .config("debug", debug)
        .config("release", release);

    app.add_source("src/release_only.coda", release);

    Artifact external = build.command(
        "cargo",
        ["build", "--release"],
        [],
        ["target/release/something"]
    );

    app.depends_on(external);

    Target tests = build.test("tests")
        .sources("src/**/*.coda")
        .exclude("src/main.coda")
        .runner("test.coda")
        .library();

    build.run();
}