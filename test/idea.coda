// a demonstration of the error system!
// possible errors
enum FileError { NotFound, Denied, }

// the `|` specifies potential return types
fn int | FileError get_base_port() {
    return FileError::NotFound; // enum namespacing
}

fn int | FileError setup_network() {
    int port = get_base_port()? + 1000; // `?` early-exits if it returns an error

    // bind_to_hardware(port, get_system_bus()?);

    return port;
}

// pattern matching
fn none pattern() {
    match (setup_network()) {
        FileError err {
            io::printn($enumstr(err));
        }
        int val {
            io::printn("Flawless.");
        }
    }
}

// constraints, templates, methods, and interfaces!

// basic function
fn none load_config<T: fn uint64 read(T mut *self, uint8[] buffer)>(T mut *source) {
    uint8[1024] buf;

    source->read(buf);
}

// requiring multiple methods on a single type using a semicolon
fn none copy_data<T: fn uint64 read(T mut *self, uint8[] buf); 
                     fn none write(T *self, uint8[] buf)>(T mut *source, T mut *dest) {
    uint8[1024] buf;
    source->read(buf);
    dest->write(buf);
}

fn none pipe_data<R: fn uint64 read(R mut *self, uint8[] buf), 
                  W: fn none write(W mut *self, uint8[] buf)>(R mut *src, W mut *dest) {
    // ...
}

