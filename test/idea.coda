fn none test_alloc() {
    // int mut *buffer = std::mem::allocate<int>(100);
    defer std::mem::default_heap.free(buffer);
    // Arena my_arena = std::mem::Arena.init();
    defer my_arena.destroy();
    // int mut *fast_buffset = std::mem::allocate<int>(100, &my_arena);
    defer std::mem::Arena.free(fast_buffset);
}

@export // export this function so it can be ran
fn int main(string[] args) {
    // the array type holds size and data
    if (args.len != 2) {
        // string literals like "foo" are stored as `string` types,
        // not char*, but they can explicitly decay
        // io::println("Missing requires arguments!");
    }

    // Coda supports c-like for loops
    for (mut uint i = 0; i < args.len; i = i + 1) {
        io::println(args[i]);
    }

    int i = 1;
    io::printf("Hello, {}!", {type_names({i})}); // potentially have implicit `{..}` for trailing `any[]` parameters

    // type casting
    uint64 big = 42424242;
    uint8 small = (uint8)big;

    // multidimensional arrays
    uint32[4][4] matrix;
}