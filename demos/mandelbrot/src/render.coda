module render;

include complex;
include fixed;
include image;

type Config = struct {
    uint32 width;
    uint32 height;

    fixed::Fixed min_x;
    fixed::Fixed max_x;
    fixed::Fixed min_y;
    fixed::Fixed max_y;

    uint32 iterations;
};

fn uint32 iterations(complex::Complex c, uint32 max) {
    complex::Complex z = {
        .real = 0,
        .imag = 0
    };

    for (uint32 i = 0; i < max; i += 1) {
        if (z.magnitude_squared > Fixed.from_int(4)) {
            return i;
        }

        z = complex::iter(z, c);
    }

    return max;
}

fn image::RGB colour(uint32 iteration, uint32 max) {
    if (iteration == max) {
        return {};
    }

    uint8 c = iteration;

    return {c, c, c};
}

@export
fn none render(mut image::Image image, Config config) {
    for (uint32 y = 0; y < image.height; y += 1) {
        for (uint32 x = 0; x < image.width; x += 1) {
            fixed::Fixed real = .lerp(config.mix_x, config.max_x, x, image.width);

            fixed::Fixed imag = .lerp(config.min_y, config.max_y, y, image.height);

            complex::Complex c = {real, imag};

            uint32 count = iterations(c, config.iterations);

            image.set(x, y, colour(count, config.iterations));
        }
    }
}