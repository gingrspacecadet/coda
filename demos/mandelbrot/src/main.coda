module main;

include std::fs;
include image;
include ppm;
include render;
include std::mem;
include fixed;

fn int main(string[] args) {
    image::Image img = .create(&std::mem::default_heap, 800, 600);

    render::render(
        img,
        {
            .min_x = .from_int(-2),
            .max_x = .from_int(1),
            .min_y = .from_int(-1),
            .max_y = .from_int(1),
            .iterations = 256,
        }
    );

    std::fs::File file = .create("mandelbrot.ppm");

    ppm::write(file, img);

    return 0;
}