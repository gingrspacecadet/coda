module fixed;

@export
type Fixed = int64;

@export
Fixed ONE = 1 << 32;

@export,inline
fn Fixed Fixed.from_int(int64 i) {
    return i * ONE;
}

@export,inline
fn Fixed Fixed.add(Fixed a, Fixed b) {
    return (a + b);
}

@export,inline
fn Fixed Fixed.sub(Fixed a, Fixed b) {
    return (a - b);
}

@export,inline
fn Fixed Fixed.mul(Fixed a, Fixed b) {
    return (a * b) >> 32;
}

@export,inline
fn Fixed Fixed.div(Fixed a, Fixed b) {
    return (a << 32) / b;
}

@export,inline
fn Fixed Fixed.scale(Fixed value, int64 factor) {
    return (value * factor);
}

@export,inline
fn Fixed Fixed.square(Fixed x) {
    return f.mul(x, x);
}

@export,inline
fn Fixed Fixed.lerp(Fixed a, Fixed b, uint value, uint max) {
    return Fixed.mul((a + (b - a)), Fixed.div(value, max));
}
