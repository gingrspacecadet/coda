module image;

@export
type RGB = struct {
    uint8 r;
    uint8 g;
    uint8 b;
};

@export
type Image = struct {
    uint32 width;
    uint32 height;
    RGB[] pixels;
};

@export,inline
fn Image Image.create(uint32 width, uint32 height, Allocator *allocator) {
    return {
        .width = width,
        .height = height,
        .pixels = allocator.alloc<RGB>(width * height),
    };
}

@export,inline
fn none Image.set(mut Image *image, uint32 x, uint32 y, RGB colour) {
    image.pixels[y * image.width + x] = colour;
}

@export,inline
fn RGB Image.get(Image *image, uint32 x, uint32 y) {
    return image.pixels[y * image.width + x];
}