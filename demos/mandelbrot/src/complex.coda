module complex;

include fixed;

@export
type Complex = struct {
    fixed::Fixed real;
    fixed::Fixed imag;
};

@export
fn Complex add(Complex a, Complex b) {
    return {
        .real = .add(a.real, b.real),
        .imag = .add(a.imag, b.imag)
    };
}

@export
fn Complex square(Complex z) {
    fixed::Fixed real = .square(z.real);
    fixed::Fixed imag = .square(z.imag);

    return {
        .real = real - imag,
        .imag = 2 * Fixed.mul(z.real, z.imag)
    };
}

@export,inline
fn fixed::Fixed Complex.magnitude_squared(Complex z) {
    return .square(z.real) + .square(z.imag);
}