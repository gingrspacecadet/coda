module std::mem;

include std::system;

fn uint8 mut *? system_alloc_pages(uint64 size) {
    uint8 mut *ptr = (uint8 mut *)std::system::syscall(9, 0u, size, 3u, 34u, 18446744073709551615u, 0u);

    if ((int64)ptr < 0) {
        return null;
    }
    return ptr;
}

fn none system_free_pages(uint8 mut *ptr, uint64 size) {
    std::system::syscall(11, (uint64)ptr, size);
}

@export
fn T *alloc<T>(uint64 count) {
    return system_alloc_pages($sizeof(T) * count);
}
