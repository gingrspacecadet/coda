module std::mem;

interface Allocator {
    fn byte[] allocate(
        mut self,
        uint64 size,
        uint64 alignment
    );

    fn none deallocate(
        mut self,
        byte[] memory
    );
}

// source and destination must not overlap
fn none copy(mut byte[] dst, byte[] src);

// source and destination may overlap
fn none move(mut byte[] dst, byte[] src);

fn none fill(mut byte[] dst, byte value);

fn none zero(mut byte[] dst);

fn int compare(byte[] lhs, byte[] rhs);

fn none swap<T>(mut T *a, mut T *b);

fn uint64 align_up(uint64 value, uint64 alignment);

fn uint64 align_down(uint64 value, uint64 alignment);