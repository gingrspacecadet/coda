module std::time;

include std::text : _;

@export
type Time = struct {
    int64 s;
    uint32 ns;
};

@export
type Duration = struct {
    int64 s;
    uint32 ns;
};

@export
type ParsedTime = struct {
    int64 year;
    uint8 month;
    uint8 day;
    uint8 hour;
    uint8 minute;
    uint8 second;
    uint32 nanosecond;
};

@export
type LeapSecond = struct {
    Time time;
    int8 amount;
};

@export
LeapSecond[] LEAP_SECONDS = {
    {{-315619200, 0}, 1},
    {{-283996800, 0}, 1},
    {{-265680000, 0}, 1},
    {{-252460800, 0}, 1},
    {{-194659200, 0}, 1},
    {{-189388800, 0}, 1},
    {{-181526400, 0}, 1},
    {{-168307200, 0}, 1},
    {{-157766400, 0}, 1},
    {{-152668800, 0}, 1},
    {{-142128000, 0}, 1},
    {{-136771200, 0}, 1},
    {{-126230400, 0}, 1},
    {{-60480000, 0}, 1},
    {{63072000, 0}, 1},
    {{78796800, 0}, 1},
    {{94694400, 0}, 1},
    {{126230400, 0}, 1},
    {{157766400, 0}, 1},
    {{189302400, 0}, 1},
    {{220924800, 0}, 1},
    {{252460800, 0}, 1},
    {{283996800, 0}, 1},
    {{315532800, 0}, 1},
    {{362793600, 0}, 1},
    {{394329600, 0}, 1},
    {{425865600, 0}, 1},
    {{489024000, 0}, 1},
    {{567993600, 0}, 1},
    {{631152000, 0}, 1},
    {{662688000, 0}, 1},
    {{709948800, 0}, 1},
    {{741484800, 0}, 1},
