@export
fn none Contiguous<T>.fill_from_slice(mut Contiguous<T>* this, Contiguous<T>* values) {
    mut usize i = 0;
    for (mut usize loc = 0; loc < this.len; loc += 1) {
        this.ptr[loc] = values.ptr[i];
        i += 1;
        if (i >= values.len) {
            i = 0;
        }
    }
}

