module std::collections;

include std::error::Error : Error;

@export
constraint Contiguous<T> = struct {
    usize len;
    T* ptr;
};

@export
constraint VarLenContiguous<T> = struct {
    usize len;
    T* ptr;
    fn (none | Error::AllocationFailed) set_len(usize new_len);
    fn (none | Error::AllocationFailed) shrink_to_fit();
};

@inline
@export
fn (usize | Error::OutOfBounds) Contiguous<T>.resolve_index(Contiguous<T>* this, ssize index) {
    if (index < 0) {
        index += this->len;
        if (index < 0) {
            return Error::OutOfBounds;
        }
    } else if (index >= this->len) {
        return Error::OutOfBounds;
    }
    return (usize)index;
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.get<T>(Contiguous<T>* this, usize index) {
    return this->ptr[this->resolve_index(index)?];
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.get_slice<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end || end - start > out->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = this->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.get_slice_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    out->set_len(end - start)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = this->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.slice<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start, usize end) {
    #inline(this->get_slice(out, start, end));
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.slice_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, usize start, usize end) {
    #inline(this->get_slice_var(out, start, end));
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set<T>(mut Contiguous<T>* this, usize index, T value) {
    this->ptr[this->resolve_index(index)?] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize index, T value) {
    index = this->resolve_index(index)?;
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = i == index ? value : this->ptr[i];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.set_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, usize index, T value) {
    index = this->resolve_index(index)?;
    out->set_len(this->len)?;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = i == index ? value : this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, Contiguous<T>* values) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end || end - start > values->len) {
        return Error::OutOfBounds;
    }
    mut usize i = 0;
    for (usize loc = start; loc < end; loc++) {
        this->ptr[loc] = values->ptr[loc];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, Contiguous<T>* values) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end || end - start > values->len) {
        return Error::OutOfBounds;
    }
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        if (i >= start && i < end) {
            out->ptr[i] = values->ptr[i - start];
        } else {
            out->ptr[i] = this->ptr[i];
        }
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.set_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, Contiguous<T>* values) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end || end - start > values->len) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len)?;
    for (mut usize i = 0; i < this->len; i++) {
        if (i >= start && i < end) {
            out->ptr[i] = values->ptr[i - start];
        } else {
            out->ptr[i] = this->ptr[i];
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.copy_to<T, U: Contiguous<T>>(Contiguous<T>* this, mut U* out) {
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
}

@export
fn (none | Error::AllocationFailed) Contiguous<T>.copy_to_var<T, U: Contiguous<T>>(Contiguous<T>* this, mut U* out) {
    out->set_len(this->len + 1)?;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_from<T>(mut Contiguous<T>* this, Contiguous<T>* values) {
    if (this->len < values->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[i] = values->ptr[i];
    }
}

@export
fn (none | Error::AllocationFailed) VarLenContiguous<T>.var_set_from<T>(mut VarLenContiguous<T>* this, Contiguous<T>* values) {
    this->set_len(values->len)?;
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[i] = values->ptr[i];
    }
}

@export
fn bool Contiguous<T>.contains(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this->len; i++) {
        if (this->ptr[i] == value) {
            return true;
        }
    }
    return false;
}

@export
fn bool Contiguous<T>.contains_slice(Contiguous<T>* this, Contiguous<T>* value) {
    for (mut usize i = 0; i < this->len - value->len; i++) {
        bool found = true;
        for (mut usize j = 0; j < value->len; j++) {
            if (this->ptr[i + j] != value->ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return true;
        }
    }
    return false;
}

@export
fn (usize | none) Contiguous<T>.index_of(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this->len; i++) {
        if (this->ptr[i] == value) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.last_index_of(Contiguous<T>* this, T value) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        if (this->ptr[i] == value) {
            return i;
        }
    }
}


@export
fn (usize | none) Contiguous<T>.index_of_slice(Contiguous<T>* this, Contiguous<T>* values) {
    for (mut usize i = 0; i < this->len; i++) {
        bool found = true;
        for (mut usize j = 0; j < value->len; j++) {
            if (this->ptr[i + j] != value->ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.last_index_of_slice(Contiguous<T>* this, Contiguous<T>* values) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        bool found = true;
        for (mut usize j = 0; j < value->len; j++) {
            if (this->ptr[i + j] != value->ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return i;
        }
    }
}

@export
fn (none | Error::AllocationFailed) VarLenContiguous<T>.push<T>(mut VarLenContiguous<T>* this, T value) {
    this->set_len(this->len + 1)?;
    this->ptr[this->len - 1] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.push_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, T value) {
    if (this->len + 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[this->len] = value;
}

@export
fn (none | Error::AllocationFailed) Contiguous<T>.push_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, T value) {
    out->set_len(this->len + 1);
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[this->len] = value;
}

@export
fn (T | Error::OutOfBounds) VarLenContiguous<T>.pop<T>(mut VarLenContiguous<T>* this) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    this->len--;
    return this->ptr[this->len];
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.pop_to<T>(Contiguous<T>* this, mut Contiguous<T>* out) {
    if (this->len == 0 || this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len - 1; i++) {
        out->ptr[i] = this->ptr[i];
    }
    return this->ptr[this->len - 1];
}

@export
fn (T | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.pop_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len - 1)?;
    for (mut usize i = 0; i < this->len - 1; i++) {
        out->ptr[i] = this->ptr[i];
    }
    return this->ptr[this->len - 1];
}

@export
fn (T | Error::OutOfBounds) VarLenContiguous<T>.shift<T>(mut VarLenContiguous<T>* this) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    T out = this->ptr[0];
    this->len--;
    for (mut usize i = 0; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + 1];
    }
    return out;
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.shift_to<T>(Contiguous<T>* this, mut Contiguous<T>* out) {
    if (this->len == 0 || this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 1; i < this->len; i++) {
        out->ptr[i - 1] = this->ptr[i];
    }
    return this->ptr[0];
}

@export
fn (T | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.shift_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len - 1)?;
    for (mut usize i = 1; i < this->len; i++) {
        out->ptr[i - 1] = this->ptr[i];
    }
    return this->ptr[0];
}

@export
fn (none | Error::AllocationFailed) VarLenContiguous<T>.unshift<T>(mut VarLenContiguous<T>* this, T value) {
    this->set_len(this->len + 1)?;
    for (mut usize i = 1; i < this->len; i++) {
        this->ptr[i] = this->ptr[i - 1];
    }
    this->ptr[0] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.unshift_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, T value) {
    if (this->len + 1 > out->len) {
        return Error::OutOfBounds;
    }
    out->ptr[0] = value;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn (none | Error::AllocationFailed) Contiguous<T>.unshift_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, T value) {
    out->set_len(this->len + 1)?;
    out->ptr[0] = value;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) VarLenContiguous<T>.delete<T>(mut VarLenContiguous<T>* this, usize index) {
    index = this->resolve_index(index)?;
    this->len--;
    for (mut usize i = index; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + 1];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.delete_to<T>(Contiguous<T>* this, mut Contiguous<T> value, usize index) {
    index = this->resolve_index(index)?;
    if (this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.delete_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T> value, usize index) {
    index = this->resolve_index(index)?;
    out->set_len(this->len - 1)?;
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
}

@export
fn (none | Error::OutOfBounds) VarLenContiguous<T>.delete_slice<T>(mut VarLenContiguous<T>* this, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->len -= deleted;
    for (mut usize i = start; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.delete_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (this->len - deleted > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.delete_slice_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->set_len(this->len - deleted)?;
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (T | Error::OutOfBounds) VarLenContiguous<T>.remove<T>(mut VarLenContiguous<T>* this, usize index) {
    index = this->resolve_index(index)?;
    this->len--;
    for (mut usize i = index; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + 1];
    }
    return this->ptr[index];
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.remove_to<T>(Contiguous<T>* this, mut Contiguous<T> value, usize index) {
    index = this->resolve_index(index)?;
    if (this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
    return this->ptr[index];
}

@export
fn (T | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.remove_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T> value, usize index) {
    index = this->resolve_index(index)?;
    out->set_len(this->len - 1)?;
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
    return this->ptr[index];
}

@export
fn (none | Error::OutOfBounds) VarLenContiguous<T>.remove_slice<T>(mut VarLenContiguous<T>* this, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (deleted > out_slice->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    this->len -= deleted;
    for (mut usize i = start; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.remove_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (deleted > out_slice->len || this->len - deleted > out->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.remove_slice_to_var<T>(Contiguous<T>* this, mut Contiguous<T>* out, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->set_len(this->len - deleted)?;
    if (deleted > out_slice->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) VarLenContiguous<T>.remove_slice_var<T>(mut VarLenContiguous<T>* this, mut VarLenContiguous<T>* out_slice, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    out->set_len(deleted)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    this->len -= deleted;
    for (mut usize i = start; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.remove_slice_var_to<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out_slice, mut Contiguous<T>* out, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (this->len - deleted > out->len) {
        return Error::OutOfBounds;
    }
    out_slice->set_len(deleted)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.remove_slice_var_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->set_len(this->len - deleted)?;
    out_slice->set_len(deleted)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (T | Error::AllocationFailed) VarLenContiguous<T>.concat<T>(mut VarLenContiguous<T>* this, Contiguous<T>* values) {
    mut usize loc = this->len;
    this->set_len(this->len + values->len)?;
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[loc] = values->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.concat_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, Contiguous<T>* values) {
    if (this->len + values->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    mut usize loc = this->len;
    for (mut usize i = 0; i < values->len; i++) {
        out->ptr[loc] = values->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::AllocationFailed) Contiguous<T>.concat_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, T value) {
    out->set_len(this->len + values->len)?;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    mut usize loc = this->len;
