        if (func(this.ptr[i])) {
            this.ptr[loc] = this.ptr[i];
            loc += 1;
        }
    }
    this.len = loc;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.filter_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, (fn T(T value))* func) {
