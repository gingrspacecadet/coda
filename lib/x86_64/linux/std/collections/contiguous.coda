@export
fn (bool | Error::OutOfBounds) Contiguous<T>.reduce_slice_right<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = end - 1; i >= start; i--) {
        start_value = func(start_value, this->ptr[i]);
    }
    return start_value;
}

@export
fn bool Contiguous<T>.every<T>(Contiguous<T>* this, (fn bool(T value))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        if (!func(this->ptr[i])) {
            return false;
        }
    }
    return true;
}

