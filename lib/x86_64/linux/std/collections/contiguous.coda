    }
}

@export
fn (none | Error::OutOfBounds) AllocatorContiguous<T>.insert_slice<T>(mut AllocatorContiguous<T>* this, ssize index, Contiguous<T>* values) {
    usize index2 = this->resolve_index(index)?;
    usize old_len = this->len;
    this->set_len(this->len + values->len)?;
    for (mut usize i = old_len; i >= index2; i--) {
        this->ptr[i + values->len] = this->ptr[i];
    }
    mut usize loc = index2;
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[loc] = values->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.insert_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, ussizesize index, Contiguous<T>* values) {
    usize index2 = this->resolve_index(index)?;
