    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], i)) {
            return true;
        }
    }
    return false;
}

@export
fn bool Contiguous<T>.contains_fn_arg_with_index<T, U>(Contiguous<T>* this, (fn T(T value, usize index, U arg))* func, U arg) {
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], i, arg)) {
            return true;
        }
    }
    return false;
}

fn none Contiguous<T>.split<T>(Contiguous<T>* this, mut AllocatorContiguous<T[]>* out, Contiguous<T>* sep) {
    usize current_start = 0;
    for (mut usize i = 0; i < this->len; i++) {
        if (this->has_slice_at(i, sep)) {
            out.push(this->view(current_start, this->len));
            i += sep->len - 1;
        }
    }
    out.push(this->view(current_start, this->len));
}

fn none Contiguous<T>.split_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<mut AllocatorContiguous<T>>* out, Contiguous<T>* sep) {
    AllocatorContiguous<T> current;
    current.init(out->allocator, 0);
    for (mut usize i = 0; i < this->len; i++) {
        if (this->has_slice_at(i, sep)) {
            i += sep->len - 1;
            out.push(current);
            current.init(out->allocator, 0);
        } else {
            current.push(this->ptr[i]);
        }
    }
    out.push(current);
}

fn none Contiguous<Contiguous<T>>.join<T>(Contiguous<Contiguous<T>>* this, mut AllocatorContiguous<T>* out, Contiguous<T>* sep) {
    for (mut usize i = 0; i < this->len; i++) {
        out.concat(&this->ptr[i]);
        if (i != this->len - 1) {
            out.concat(sep);
        }
    }
}

fn none Contiguous<Contiguous<T>*>.join_ptr<T>(Contiguous<Contiguous<T>*>* this, mut AllocatorContiguous<T>* out, Contiguous<T>* sep) {
    for (mut usize i = 0; i < this->len; i++) {
        out.concat(this->ptr[i]);
        if (i != this->len - 1) {
            out.concat(sep);
        }
    }
}