fn (none | Error::OutOfBounds) Contiguous<T>.map_slice_to_alloc<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value))* func) {
    usize start = this->resolve_index(start_index)?;
