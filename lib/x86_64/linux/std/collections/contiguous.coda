@export
fn (none | T) Contiguous<T>.find_value<T>(Contiguous<T>* this, (fn bool(T value))* func) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (func(this.ptr[i])) {
            return this.ptr[i];
