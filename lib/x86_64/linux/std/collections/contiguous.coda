@export
fn (none | Error::OutOfBounds) AllocatorContiguous<T>.insert<T>(mut AllocatorContiguous<T>* this, ssize index, T value) {
    usize index2 = this->resolve_index(index)?;
    this->set_len(this->len + 1)?;
    for (mut usize i = index2; i < this->len - 1; i++) {
        this->ptr[i + 1] = this->ptr[i];
    }
    this->ptr[index2] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.insert_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, ssize index, T value) {
    usize index2 = this->resolve_index(index)?;
    if (this->len + 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index2; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[index] = value;
    for (mut usize i = index2; i < this->len - 1; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.insert_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, ssize index, T value) {
    usize index2 = this->resolve_index(index)?;
    out->set_len(this->len + 1)?;
