fn (none | usize) Contiguous<T>.find_with_index_index<T>(Contiguous<T>* this, (fn bool(T value, usize index))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], i)) {
            return i;
        }
    }
}

