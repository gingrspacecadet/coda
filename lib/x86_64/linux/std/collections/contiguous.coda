@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.filter_to_list<T>(Contiguous<T>* this, mut List<T>* out, (fn T(T value))* func) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (func(this.ptr[i])) {
            #inline(out.push(this.ptr[i]));
        }
    }
}

@export
fn none Contiguous<T>.filter_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    mut usize deleted = 0;
    for (mut usize i = start; i < end; i += 1) {
        if (func(this.ptr[i])) {
            this.ptr[loc] = this.ptr[i];
            loc += 1;
        } else {
            deleted += 1;
        }
    }
    if (deleted > 0) {
        for (mut usize i = end; i < this.len; i += 1) {
            this.ptr[i - deleted] = this.ptr[i];
        }
    }
    this.len = loc;
}

