}

@export
fn bool Contiguous<T>.reduce<T, U>(Contiguous<T>* this, mut U start, (fn bool(U prev, T value))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        start_value = func(start_value, this->ptr[i]);
    }
    return start_value;
}

@export
fn bool Contiguous<T>.reduce_right<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value))* func) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        start_value = func(start_value, this->ptr[i]);
    }
    return start_value;
}

@export
fn (bool | Error::OutOfBounds) Contiguous<T>.reduce_slice<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value))* func) {
