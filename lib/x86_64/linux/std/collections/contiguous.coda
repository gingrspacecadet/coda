    for (mut usize i = index; i < this->len - 1; i++) {
        out->ptr[i + values->len] = this->ptr[i];
    }
}

@export
fn none Contiguous<T>.fill(mut Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this->len; i++) {
        this->ptr[i] = value;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.fill_slice(mut Contiguous<T>* this, usize start_index, usize end_index, T value) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = start; i < end; i++) {
        this->ptr[i] = value;
    }
}

@export
fn none Contiguous<T>.fill_from_slice(mut Contiguous<T>* this, Contiguous<T>* values) {
    mut usize i = 0;
    for (mut usize loc = 0; loc < this->len; loc++) {
        this->ptr[loc] = values->ptr[i];
        i++;
        if (i >= values->len) {
            i = 0;
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.fill_slice_from_slice(mut Contiguous<T>* this, usize start_index, usize end_index, T value) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    mut usize i = 0;
    for (mut usize loc = start; loc < end; loc++) {
        this->ptr[loc] = values->ptr[i];
        i++;
        if (i >= values->len) {
            i = 0;
        }
    }
}

@export
fn none Contiguous<T>.reverse(mut Contiguous<T>* this) {
    for (mut usize i = 0; i <= this->len / 2; i++) {
        T temp = this->ptr[i];
        this->ptr[i] = this->ptr[this->len - 1 - i];
        this->ptr[this->len - 1 - i] = temp;
    }
}

@export
fn none Contiguous<T>.reverse_slice(mut Contiguous<T>* this) {
    for (mut usize i = 0; i <= this->len / 2; i++) {
        T temp = this->ptr[i];
        this->ptr[i] = this->ptr[this->len - 1 - i];
        this->ptr[this->len - 1 - i] = temp;
    }
}

@export
fn none Contiguous<T>.map<T>(mut Contiguous<T>* this, (fn T(T value))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        this->ptr[i] = func(this->ptr[i]);
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.map_to<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, (fn T(T value))* func) {
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = func(this->ptr[i]);
    }
}

