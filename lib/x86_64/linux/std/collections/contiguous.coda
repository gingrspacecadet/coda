fn (none | usize) Contiguous<T>.find_with_index_last_index<T>(Contiguous<T>* this, (fn bool(T value, usize index))* func) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        if (func(this->ptr[i], i)) {
