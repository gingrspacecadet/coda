        return Error::OutOfBounds;
    }
    for (mut usize i = end - 1; i >= start; i--) {
        if (func(this->ptr[i])) {
            return i;
        }
    }
}

@export
fn bool Contiguous<T>.contains_fn(Contiguous<T>* this, (fn T(T value))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i])) {
            return true;
        }
    }
    return false;
}

@export
fn bool Contiguous<T>.contains_fn_arg<T, U>(Contiguous<T>* this, (fn T(T value, U arg))* func, U arg) {
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], arg)) {
            return true;
        }
    }
    return false;
}

@export
fn none Contiguous<T>.map_with_index<T>(mut Contiguous<T>* this, (fn T(T value, usize index))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        this->ptr[i] = func(this->ptr[i], i);
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.map_with_index_to<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, (fn T(T value, usize index))* func) {
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = func(this->ptr[i], i);
    }
}

@export
fn none Contiguous<T>.map_with_index_to_alloc<T>(mut Contiguous<T>* this, mut AllocatorContiguous<T>* out, (fn T(T value, usize index))* func) {
    out->set_len(this->len)?;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = func(this->ptr[i], i);
    }
}

@export
fn none Contiguous<T>.map_with_index_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = start; i < end; i++) {
        this->ptr[i] = func(this->ptr[i], i);
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.map_with_index_slice_to<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end || end - start > out->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = func(this->ptr[i], i);
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.map_with_index_slice_to_alloc<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = func(this->ptr[i], i);
        loc++;
    }
}

@export
fn none Contiguous<T>.filter_with_index<T>(mut Contiguous<T>* this, (fn T(T value, usize index))* func) {
    mut usize loc = 0;
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], i)) {
            this->ptr[loc] = this->ptr[i];
            loc++;
        }
    }
    this->len = loc;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_with_index_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, (fn T(T value, usize index))* func) {
    mut usize loc = 0;
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], i)) {
            out->ptr[loc] = this->ptr[i];
            loc++;
            if (loc >= out->len) {
                return Error::OutOfBounds;
            }
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_with_index_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, (fn T(T value, usize index))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i], i)) {
            #inline(out->push(this->ptr[i]));
        }
    }
}

@export
fn none Contiguous<T>.filter_with_index_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    mut usize deleted = 0;
    for (mut usize i = start; i < end; i++) {
        if (func(this->ptr[i], i)) {
            this->ptr[loc] = this->ptr[i];
            loc++;
        } else {
            deleted++;
        }
    }
    if (deleted > 0) {
        for (mut usize i = end; i < this->len; i++) {
            this->ptr[i - deleted] = this->ptr[i];
        }
    }
    this->len = loc;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_with_index_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        if (func(this->ptr[i], i)) {
            out->ptr[loc] = this->ptr[i];
            loc++;
            if (loc >= out->len) {
                return Error::OutOfBounds;
            }
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_with_index_slice_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = start; i < end; i++) {
        if (func(this->ptr[i], i)) {
            #inline(out->push(this->ptr[i]));
        }
    }
}

@export
fn bool Contiguous<T>.reduce_with_index<T, U>(Contiguous<T>* this, mut U start, (fn bool(U prev, T value, usize index))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        start_value = func(start_value, this->ptr[i], i);
    }
    return start_value;
}

@export
fn bool Contiguous<T>.reduce_with_index_right<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value, usize index))* func) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        start_value = func(start_value, this->ptr[i], i);
    }
    return start_value;
}

@export
fn (bool | Error::OutOfBounds) Contiguous<T>.reduce_with_index_slice<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = start; i < end; i++) {
        start_value = func(start_value, this->ptr[i], i);
    }
    return start_value;
}

@export
fn (bool | Error::OutOfBounds) Contiguous<T>.reduce_with_index_slice_right<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value, usize index))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = end - 1; i >= start; i--) {
        start_value = func(start_value, this->ptr[i], i);
    }
    return start_value;
}

@export
fn bool Contiguous<T>.every_with_index<T>(Contiguous<T>* this, (fn bool(T value, usize index))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        if (!func(this->ptr[i], i)) {
            return false;
        }
    }
    return true;
}

@export
fn (bool | Error::OutOfBounds) Contiguous<T>.every_with_index_slice<T>(Contiguous<T>* this, usize start_index, usize end_index, (fn bool(T value, usize index))* func) {
