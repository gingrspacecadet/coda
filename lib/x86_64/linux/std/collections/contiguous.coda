}

@export
fn none Contiguous<T>.map_with_index<T>(mut Contiguous<T>* this, (fn T(T value, usize index))* func) {
    for (mut usize i = 0; i < this.len; i += 1) {
        this.ptr[i] = func(this.ptr[i], i);
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.map_with_index_to<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, (fn U(T value, usize index))* func) {
    if (this.len > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = func(this.ptr[i], i);
    }
}

@export
fn none Contiguous<T>.map_with_index_to_list<T, U>(mut Contiguous<T>* this, mut List<U>* out, (fn U(T value, usize index))* func) {
    out.set_len(this.len)?;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = func(this.ptr[i], i);
    }
}

@export
fn none Contiguous<T>.map_with_index_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = start; i < end; i += 1) {
        this.ptr[i] = func(this.ptr[i], i);
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.map_with_index_slice_to<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, usize start_index, usize end_index, (fn U(T value, usize index))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = func(this.ptr[i], i);
        loc += 1;
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.map_with_index_slice_to_list<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, usize start_index, usize end_index, (fn U(T value, usize index))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(this.len)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = func(this.ptr[i], i);
        loc += 1;
    }
}

@export
fn none Contiguous<T>.filter_with_index<T>(mut Contiguous<T>* this, (fn T(T value, usize index))* func) {
    mut usize loc = 0;
    for (mut usize i = 0; i < this.len; i += 1) {
        if (func(this.ptr[i], i)) {
            this.ptr[loc] = this.ptr[i];
            loc += 1;
        }
    }
    this.len = loc;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.filter_with_index_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, (fn T(T value, usize index))* func) {
    mut usize loc = 0;
    for (mut usize i = 0; i < this.len; i += 1) {
        if (func(this.ptr[i], i)) {
            out.ptr[loc] = this.ptr[i];
            loc += 1;
            if (loc >= out.len) {
                return Error::OUT_OF_BOUNDS;
            }
        }
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.filter_with_index_to_list<T>(Contiguous<T>* this, mut List<T>* out, (fn T(T value, usize index))* func) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (func(this.ptr[i], i)) {
            #inline(out.push(this.ptr[i]));
        }
    }
}

@export
fn none Contiguous<T>.filter_with_index_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    mut usize deleted = 0;
    for (mut usize i = start; i < end; i += 1) {
        if (func(this.ptr[i], i)) {
            this.ptr[loc] = this.ptr[i];
            loc += 1;
        } else {
            deleted += 1;
        }
    }
    if (deleted > 0) {
        for (mut usize i = end; i < this.len; i += 1) {
            this.ptr[i - deleted] = this.ptr[i];
        }
    }
    this.len = loc;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.filter_with_index_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        if (func(this.ptr[i], i)) {
            out.ptr[loc] = this.ptr[i];
            loc += 1;
            if (loc >= out.len) {
                return Error::OUT_OF_BOUNDS;
            }
        }
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.filter_with_index_slice_to_list<T>(Contiguous<T>* this, mut List<T>* out, usize start_index, usize end_index, (fn T(T value, usize index))* func) {
    usize start = this.resolve_index(start_index)?;
