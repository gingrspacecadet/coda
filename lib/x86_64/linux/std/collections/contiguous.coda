fn (none | Error::OutOfBounds) Contiguous<T>.insert_slice_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, ssize index, Contiguous<T>* values) {
    usize index2 = this->resolve_index(index)?;
