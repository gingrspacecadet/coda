@export
fn none Contiguous<T>.filter<T>(mut Contiguous<T>* this, (fn T(T value))* func) {
    mut usize loc = 0;
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i])) {
            this->ptr[loc] = this->ptr[i];
            loc++;
        }
    }
    this->len = loc;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, (fn T(T value))* func) {
    mut usize loc = 0;
    for (mut usize i = 0; i < this->len; i++) {
