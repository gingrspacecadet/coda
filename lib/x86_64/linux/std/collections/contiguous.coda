    }
}

@export
fn none Contiguous<T>.map_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value))* func) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    for (mut usize i = start; i < end; i++) {
        this->ptr[i] = func(this->ptr[i]);
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.map_slice_to<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value))* func) {
    start = this->resolve_index(start_index)?;
    end = this->resolve_index(end_index)?;
    if (start > end || end - start > out->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = func(this->ptr[i]);
        loc++;
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.map_slice_to_var<T>(mut Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value))* func) {
    start = this->resolve_index(start_index)?;
