@export
fn bool Contiguous<T>.reduce<T, U>(Contiguous<T>* this, mut U start, (fn bool(U prev, T value))* func) {
    for (mut usize i = 0; i < this.len; i += 1) {
        start_value = func(start_value, this.ptr[i]);
    }
    return start_value;
}

@export
fn bool Contiguous<T>.reduce_right<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value))* func) {
    for (mut ssize i = this.len - 1; i >= 0; i -= 1) {
        start_value = func(start_value, this.ptr[i]);
    }
    return start_value;
}

@export
fn (bool | Error::OUT_OF_BOUNDS) Contiguous<T>.reduce_slice<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = start; i < end; i += 1) {
        start_value = func(start_value, this.ptr[i]);
    }
    return start_value;
}

@export
fn (bool | Error::OUT_OF_BOUNDS) Contiguous<T>.reduce_slice_right<T, U>(Contiguous<T>* this, mut U start_value, (fn bool(U prev, T value))* func) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut ssize i = end - 1; i >= start; i -= 1) {
        start_value = func(start_value, this.ptr[i]);
    }
    return start_value;
}

@export
fn bool Contiguous<T>.every<T>(Contiguous<T>* this, (fn bool(T value))* func) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (!func(this.ptr[i])) {
            return false;
        }
    }
    return true;
}

@export
fn (bool | Error::OUT_OF_BOUNDS) Contiguous<T>.every_slice<T>(Contiguous<T>* this, usize start_index, usize end_index, (fn bool(T value))* func) {
    usize start = this.resolve_index(start_index)?;
