module std::collections;

include std::error = _;

@export
constraint Contiguous<T>: Indexed<T> = {
    T* ptr;
};

@export
fn (T | Error::OUT_OF_BOUNDS) Contiguous<T>.get<T>(Contiguous<T>* this, ssize index) {
    return this.ptr[this.resolve_index(index)?];
}

@export
fn (T* | Error::OUT_OF_BOUNDS) Contiguous<T>.get_ptr<T>(Contiguous<T>* this, ssize index) {
    return &this.ptr[this.resolve_index(index)?];
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.get_slice<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = this.ptr[i];
        loc += 1;
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.get_slice_list<T>(Contiguous<T>* this, mut List<T>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(end - start)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = this.ptr[i];
        loc += 1;
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.slice<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start, usize end) {
    #inline(this.get_slice(out, start, end));
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.slice_list<T>(Contiguous<T>* this, mut List<T>* out, usize start, usize end) {
    #inline(this.get_slice_list(out, start, end));
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set<T>(mut Contiguous<T>* this, ssize index, T value) {
    this.ptr[this.resolve_index(index)?] = value;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, ssize index, T value) {
    usize index2 = this.resolve_index(index)?;
    if (this.len > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = i == index2 ? value : this.ptr[i];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_to_list<T>(Contiguous<T>* this, mut List<T>* out, ssize index, T value) {
    usize index2 = this.resolve_index(index)?;
    out.set_len(this.len)?;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = i == index2 ? value : this.ptr[i];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_ptr<T>(mut Contiguous<T>* this, ssize index, T* value) {
    this.ptr[this.resolve_index(index)?] = *value;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, Contiguous<T>* values) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > values.len) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize i = 0;
    for (usize loc = start; loc < end; loc += 1) {
        this.ptr[loc] = values.ptr[loc];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, Contiguous<T>* values) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > values.len) {
        return Error::OUT_OF_BOUNDS;
    }
    if (this.len > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        if (i >= start && i < end) {
            out.ptr[i] = values.ptr[i - start];
        } else {
            out.ptr[i] = this.ptr[i];
        }
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_slice_to_list<T>(Contiguous<T>* this, mut List<T>* out, usize start_index, usize end_index, Contiguous<T>* values) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > values.len) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(this.len)?;
    for (mut usize i = 0; i < this.len; i += 1) {
        if (i >= start && i < end) {
            out.ptr[i] = values.ptr[i - start];
        } else {
            out.ptr[i] = this.ptr[i];
        }
    }
}

@export
fn (T[] | Error::OUT_OF_BOUNDS) Contiguous<T>.view(Contiguous<T>* this, ssize start_index, ssize end_index) {
    usize start = this.resolve_index(start_index);
    usize end = this.resolve_index(end_index);
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    return (T[]){.len = end - start, .ptr = this.ptr + start};
}

@export
fn T[] Contiguous<T>.to_array(Contiguous<T>* this) {
    return (T[]){.len = end - start, .ptr = this.ptr + start};
}

@export
fn bool Contiguous<T>.eq<T>(Contiguous<T>* this, Contiguous<T>* value) {
    if (this.len != value.len) {
        return false;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        if (this.ptr[i] != value.ptr[i]) {
            return false;
        }
    }
    return true;
}

@export
fn (bool | Error::OUT_OF_BOUNDS) Contiguous<T>.eq_slice(Contiguous<T>* this, ssize index, Contiguous<T>* value) {
    usize index2 = this.resolve_index(index)?;
    if (index2 + value.len > this.len) {
        return false;
    }
    mut usize loc = index2;
    for (mut usize i = 0; i < value.len; i += 1) {
        if (this.ptr[loc] != value.ptr[i]) {
            return false;
        }
        loc += 1;
    }
    return true;
}


@export
fn bool Contiguous<T>.contains(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (this.ptr[i] == value) {
            return true;
        }
    }
    return false;
}

@export
fn bool Contiguous<T>.contains_slice(Contiguous<T>* this, Contiguous<T>* value) {
    for (mut usize i = 0; i < this.len - value.len; i += 1) {
        bool found = true;
        for (mut usize j = 0; j < value.len; j += 1) {
            if (this.ptr[i + j] != value.ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return true;
        }
    }
    return false;
}

@export
fn bool Contiguous<T>.all_eq<T>(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (this.ptr[i] != value) {
            return false;
        }
    }
    return true;
}

@export
fn (bool | Error::OUT_OF_BOUNDS) Contiguous<T>.all_eq_slice<T>(Contiguous<T>* this, ssize start_index, ssize end_index, T value) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    for (mut usize i = start; i < end; i += 1) {
        if (this.ptr[i] != value) {
            return false;
        }
    }
    return true;
}

@export
fn bool Contiguous<T>.starts_with(Contiguous<T>* this, T value) {
    return this.len > 0 && this.ptr[0] == value;
}

@export
fn bool Contiguous<T>.starts_with_slice(Contiguous<T>* this, Contiguous<T>* value) {
    if (this.len < value.len) {
        return false;
    }
    for (mut usize i = 0; i < value.len; i += 1) {
        if (this.ptr[i] != value.ptr[i]) {
            return false;
        }
    }
    return true;
}

@export
fn bool Contiguous<T>.ends_with(Contiguous<T>* this, T value) {
    return this.len > 0 && this.ptr[this.len - 1] == value;
}

@export
fn bool Contiguous<T>.ends_with_slice(Contiguous<T>* this, Contiguous<T>* value) {
    if (this.len < value.len) {
        return false;
    }
    mut usize j = 0;
    for (mut usize i = this.len - value.len; i < this.len; i += 1) {
        if (this.ptr[i] != value.ptr[j]) {
            return false;
        }
        j += 1;
    }
    return true;
}

@export
fn (usize | none) Contiguous<T>.index_of(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this.len; i += 1) {
        if (this.ptr[i] == value) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.last_index_of(Contiguous<T>* this, T value) {
    for (mut ssize i = this.len - 1; i >= 0; i -= 1) {
        if (this.ptr[i] == value) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.index_of_slice(Contiguous<T>* this, Contiguous<T>* values) {
    for (mut usize i = 0; i < this.len; i += 1) {
        bool found = true;
        for (mut usize j = 0; j < value.len; j += 1) {
            if (this.ptr[i + j] != value.ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.last_index_of_slice(Contiguous<T>* this, Contiguous<T>* values) {
    for (mut ssize i = this.len - 1; i >= 0; i -= 1) {
        bool found = true;
        for (mut usize j = 0; j < value.len; j += 1) {
            if (this.ptr[i + j] != value.ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return i;
        }
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.copy_to<T, U: Contiguous<T>>(Contiguous<T>* this, mut U* out) {
    if (this.len > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
}

@export
fn none Contiguous<T>.copy_to_list<T, U: Contiguous<T>>(Contiguous<T>* this, mut U* out) {
    out.set_len(this.len + 1)?;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.set_from<T>(mut Contiguous<T>* this, Contiguous<T>* values) {
    if (this.len < values.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < values.len; i += 1) {
        this.ptr[i] = values.ptr[i];
    }
}

@export
fn none List<T>.list_set_from<T>(mut List<T>* this, Contiguous<T>* values) {
    this.set_len(values.len)?;
    for (mut usize i = 0; i < values.len; i += 1) {
        this.ptr[i] = values.ptr[i];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.cast_to<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out) {
    if (this.len > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = (U)(this.ptr[i]);
    }
}

@export
fn none Contiguous<T>.cast_to_list<T, U>(mut Contiguous<T>* this, mut List<U>* out) {
    out.set_len(this.len)?;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = (U)(this.ptr[i]);
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.cast_slice_to<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = (U)(this.ptr[i]);
        loc += 1;
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.cast_slice_to_list<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(this.len)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = (U)(this.ptr[i]);
        loc += 1;
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.bit_cast_to<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out) {
    if (this.len > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = #bit_cast<U>(this.ptr[i]);
    }
}

@export
fn none Contiguous<T>.bit_cast_to_list<T, U>(mut Contiguous<T>* this, mut List<U>* out) {
    out.set_len(this.len)?;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = #bit_cast<U>(this.ptr[i]);
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.bit_cast_slice_to<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end || end - start > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = #bit_cast<U>(this.ptr[i]);
        loc += 1;
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.bit_cast_slice_to_list<T, U>(mut Contiguous<T>* this, mut Contiguous<U>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(this.len)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i += 1) {
        out.ptr[loc] = #bit_cast<U>(this.ptr[i]);
        loc += 1;
    }
}

@export
fn (none | Error::NOT_INITALIZED) List<T>.reset<T>(mut List<T>* this, usize len) {
    if (!this.allocator) {
        return Error::NOT_INITALIZED;
    }
    this.destroy();
    this.init(this.allocator, len);
}

@export
fn (none | Error::NOT_INITALIZED) List<T>.clear<T>(mut List<T>* this) {
    return #inline(this.reset(0));
}

@export
fn none List<T>.push<T>(mut List<T>* this, T value) {
    this.set_len(this.len + 1)?;
    this.ptr[this.len - 1] = value;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.push_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, T value) {
    if (this.len + 1 > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    out.ptr[this.len] = value;
}

@export
fn none Contiguous<T>.push_to_list<T>(Contiguous<T>* this, mut List<T>* out, T value) {
    out.set_len(this.len + 1);
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    out.ptr[this.len] = value;
}

@export
fn (T | Error::OUT_OF_BOUNDS) List<T>.pop<T>(mut List<T>* this) {
    if (this.len == 0) {
        return Error::OUT_OF_BOUNDS;
    }
    this.len -= 1;
    return this.ptr[this.len];
}

@export
fn (T | Error::OUT_OF_BOUNDS) Contiguous<T>.pop_to<T>(Contiguous<T>* this, mut Contiguous<T>* out) {
    if (this.len == 0 || this.len - 1 > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < this.len - 1; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    return this.ptr[this.len - 1];
}

@export
fn (T | Error::OUT_OF_BOUNDS) Contiguous<T>.pop_to_list<T>(Contiguous<T>* this, mut List<T>* out) {
    if (this.len == 0) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(this.len - 1)?;
    for (mut usize i = 0; i < this.len - 1; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    return this.ptr[this.len - 1];
}

@export
fn (T | Error::OUT_OF_BOUNDS) List<T>.shift<T>(mut List<T>* this) {
    if (this.len == 0) {
        return Error::OUT_OF_BOUNDS;
    }
    T out = this.ptr[0];
    this.len -= 1;
    for (mut usize i = 0; i < this.len; i += 1) {
        this.ptr[i] = this.ptr[i + 1];
    }
    return out;
}

@export
fn (T | Error::OUT_OF_BOUNDS) Contiguous<T>.shift_to<T>(Contiguous<T>* this, mut Contiguous<T>* out) {
    if (this.len == 0 || this.len - 1 > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 1; i < this.len; i += 1) {
        out.ptr[i - 1] = this.ptr[i];
    }
    return this.ptr[0];
}

@export
fn (T | Error::OUT_OF_BOUNDS) Contiguous<T>.shift_to_list<T>(Contiguous<T>* this, mut List<T>* out) {
    if (this.len == 0) {
        return Error::OUT_OF_BOUNDS;
    }
    out.set_len(this.len - 1)?;
    for (mut usize i = 1; i < this.len; i += 1) {
        out.ptr[i - 1] = this.ptr[i];
    }
    return this.ptr[0];
}

@export
fn none List<T>.unshift<T>(mut List<T>* this, T value) {
    this.set_len(this.len + 1)?;
    for (mut usize i = 1; i < this.len; i += 1) {
        this.ptr[i] = this.ptr[i - 1];
    }
    this.ptr[0] = value;
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.unshift_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, T value) {
    if (this.len + 1 > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    out.ptr[0] = value;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i + 1] = this.ptr[i];
    }
}

@export
fn none Contiguous<T>.unshift_to_list<T>(Contiguous<T>* this, mut List<T>* out, T value) {
    out.set_len(this.len + 1)?;
    out.ptr[0] = value;
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i + 1] = this.ptr[i];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) List<T>.delete<T>(mut List<T>* this, ssize index) {
    usize index2 = this.resolve_index(index)?;
    this.len -= 1;
    for (mut usize i = index2; i < this.len; i += 1) {
        this.ptr[i] = this.ptr[i + 1];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.delete_to<T>(Contiguous<T>* this, mut Contiguous<T> value, ssize index) {
    usize index2 = this.resolve_index(index)?;
    if (this.len - 1 > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
    for (mut usize i = 0; i < index2; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    for (mut usize i = index2; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i + 1];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.delete_to_list<T>(Contiguous<T>* this, mut List<T> value, ssize index) {
    usize index2 = this.resolve_index(index)?;
    out.set_len(this.len - 1)?;
    for (mut usize i = 0; i < index2; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    for (mut usize i = index2; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i + 1];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) List<T>.delete_slice<T>(mut List<T>* this, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    usize deleted = end - start;
    this.len -= deleted;
    for (mut usize i = start; i < this.len; i += 1) {
        this.ptr[i] = this.ptr[i + deleted];
    }
}

@export
fn (none | Error::OUT_OF_BOUNDS) Contiguous<T>.delete_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index) {
    usize start = this.resolve_index(start_index)?;
    usize end = this.resolve_index(end_index)?;
    if (start > end) {
        return Error::OUT_OF_BOUNDS;
    }
    usize deleted = end - start;
    if (this.len - deleted > out.len) {
        return Error::OUT_OF_BOUNDS;
    }
