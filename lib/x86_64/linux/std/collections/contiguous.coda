module std::collections;

include std::error : _;

@export
constraint Contiguous<T> = struct {
    usize len;
    T* ptr;
};

@export
constraint AllocatorContiguous<T> = struct: Contiguous<T> {
    Allocator* allocator;
    usize len;
    T* ptr;
    fn none init(mut AllocatorContiguous* this, Allocator* allocator, usize new_len);
    fn none destroy();
    fn none set_len(mut AllocatorContiguous* this, usize new_len);
    fn none shrink_to_fit(mut AllocatorContiguous* this);
};

@export
constraint NonAllocatorContiguous<T> = Contiguous<T> && !AllocatorContiguous<T>;

@inline
@export
fn (usize | Error::OutOfBounds) Contiguous<T>.resolve_index(Contiguous<T>* this, ssize index) {
    if (index < 0) {
        index += this->len;
        if (index < 0) {
            return Error::OutOfBounds;
        }
    } else if (index >= this->len) {
        return Error::OutOfBounds;
    }
    return (usize)index;
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.get<T>(Contiguous<T>* this, ssize index) {
    return this->ptr[this->resolve_index(index)?];
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.get_slice<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end || end - start > out->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = this->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.get_slice_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    out->set_len(end - start)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out->ptr[loc] = this->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.slice<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start, usize end) {
    #inline(this->get_slice(out, start, end));
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.slice_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, usize start, usize end) {
    #inline(this->get_slice_alloc(out, start, end));
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set<T>(mut Contiguous<T>* this, ssize index, T value) {
    this->ptr[this->resolve_index(index)?] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, ssize index, T value) {
    usize index2 = this->resolve_index(index)?;
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = i == index2 ? value : this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, ssize index, T value) {
    usize index2 = this->resolve_index(index)?;
    out->set_len(this->len)?;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = i == index2 ? value : this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, Contiguous<T>* values) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end || end - start > values->len) {
        return Error::OutOfBounds;
    }
    mut usize i = 0;
    for (usize loc = start; loc < end; loc++) {
        this->ptr[loc] = values->ptr[loc];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, Contiguous<T>* values) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end || end - start > values->len) {
        return Error::OutOfBounds;
    }
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        if (i >= start && i < end) {
            out->ptr[i] = values->ptr[i - start];
        } else {
            out->ptr[i] = this->ptr[i];
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_slice_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, usize start_index, usize end_index, Contiguous<T>* values) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end || end - start > values->len) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len)?;
    for (mut usize i = 0; i < this->len; i++) {
        if (i >= start && i < end) {
            out->ptr[i] = values->ptr[i - start];
        } else {
            out->ptr[i] = this->ptr[i];
        }
    }
}

@export
fn (T[] | Error::OutOfBounds) Contiguous<T>.view(Contiguous<T>* this, ssize start_index, ssize end_index) {
    usize start = this->resolve_index(start_index);
    usize end = this->resolve_index(end_index);
    if (start > end) {
        return Error::OutOfBounds;
    }
    return (T[]){.len = end - start, .ptr = this->ptr + start};
}

@export
fn bool Contiguous<T>.eq(Contiguous<T>* this, Contiguous<T>* value) {
    if (this->len != value->len) {
        return false;
    }
    for (mut usize i = 0; i < this->len; i++) {
        if (this->ptr[i] != value->ptr[i]) {
            return false;
        }
    }
    return true;
}

@export
fn bool Contiguous<T>.contains(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this->len; i++) {
        if (this->ptr[i] == value) {
            return true;
        }
    }
    return false;
}

@export
fn bool Contiguous<T>.contains_slice(Contiguous<T>* this, Contiguous<T>* value) {
    for (mut usize i = 0; i < this->len - value->len; i++) {
        bool found = true;
        for (mut usize j = 0; j < value->len; j++) {
            if (this->ptr[i + j] != value->ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return true;
        }
    }
    return false;
}

@export
fn (bool | Error::OutOfBounds) Contiguous<T>.has_slice_at(Contiguous<T>* this, ssize index, Contiguous<T>* value) {
    usize index2 = this->resolve_index(index)?;
    if (index2 + value->len > this->len) {
        return false;
    }
    mut usize loc = index2;
    for (mut usize i = 0; i < value->len; i++) {
        if (this->ptr[loc] != value->ptr[i]) {
            return false;
        }
        loc++;
    }
    return true;
}

@export
fn bool Contiguous<T>.starts_with(Contiguous<T>* this, T value) {
    return this->len > 0 && this->ptr[0] == value;
}

@export
fn bool Contiguous<T>.starts_with_slice(Contiguous<T>* this, Contiguous<T>* value) {
    if (this->len < value->len) {
        return false;
    }
    for (mut usize i = 0; i < value->len; i++) {
        if (this->ptr[i] != value->ptr[i]) {
            return false;
        }
    }
    return true;
}

@export
fn bool Contiguous<T>.ends_with(Contiguous<T>* this, T value) {
    return this->len > 0 && this->ptr[this->len - 1] == value;
}

@export
fn bool Contiguous<T>.ends_with_slice(Contiguous<T>* this, Contiguous<T>* value) {
    if (this->len < value->len) {
        return false;
    }
    mut usize j = 0;
    for (mut usize i = this->len - value->len; i < this->len; i++) {
        if (this->ptr[i] != value->ptr[j]) {
            return false;
        }
        j++;
    }
    return true;
}

@export
fn (usize | none) Contiguous<T>.index_of(Contiguous<T>* this, T value) {
    for (mut usize i = 0; i < this->len; i++) {
        if (this->ptr[i] == value) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.last_index_of(Contiguous<T>* this, T value) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        if (this->ptr[i] == value) {
            return i;
        }
    }
}


@export
fn (usize | none) Contiguous<T>.index_of_slice(Contiguous<T>* this, Contiguous<T>* values) {
    for (mut usize i = 0; i < this->len; i++) {
        bool found = true;
        for (mut usize j = 0; j < value->len; j++) {
            if (this->ptr[i + j] != value->ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return i;
        }
    }
}

@export
fn (usize | none) Contiguous<T>.last_index_of_slice(Contiguous<T>* this, Contiguous<T>* values) {
    for (mut usize i = this->len - 1; i >= 0; i--) {
        bool found = true;
        for (mut usize j = 0; j < value->len; j++) {
            if (this->ptr[i + j] != value->ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) {
            return i;
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.copy_to<T, U: Contiguous<T>>(Contiguous<T>* this, mut U* out) {
    if (this->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
}

@export
fn none Contiguous<T>.copy_to_alloc<T, U: Contiguous<T>>(Contiguous<T>* this, mut U* out) {
    out->set_len(this->len + 1)?;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.set_from<T>(mut Contiguous<T>* this, Contiguous<T>* values) {
    if (this->len < values->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[i] = values->ptr[i];
    }
}

@export
fn none AllocatorContiguous<T>.alloc_set_from<T>(mut AllocatorContiguous<T>* this, Contiguous<T>* values) {
    this->set_len(values->len)?;
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[i] = values->ptr[i];
    }
}

@export
fn none AllocatorContiguous<T>.clear<T>(mut AllocatorContiguous<T>* this) {
    if (this->len == 0) {
        return;
    }
    this->destroy();
    this->init(this->allocator, 0);
}

@export
fn none AllocatorContiguous<T>.push<T>(mut AllocatorContiguous<T>* this, T value) {
    this->set_len(this->len + 1)?;
    this->ptr[this->len - 1] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.push_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, T value) {
    if (this->len + 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[this->len] = value;
}

@export
fn none Contiguous<T>.push_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, T value) {
    out->set_len(this->len + 1);
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[this->len] = value;
}

@export
fn (T | Error::OutOfBounds) AllocatorContiguous<T>.pop<T>(mut AllocatorContiguous<T>* this) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    this->len--;
    return this->ptr[this->len];
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.pop_to<T>(Contiguous<T>* this, mut Contiguous<T>* out) {
    if (this->len == 0 || this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len - 1; i++) {
        out->ptr[i] = this->ptr[i];
    }
    return this->ptr[this->len - 1];
}

@export
fn (T | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.pop_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len - 1)?;
    for (mut usize i = 0; i < this->len - 1; i++) {
        out->ptr[i] = this->ptr[i];
    }
    return this->ptr[this->len - 1];
}

@export
fn (T | Error::OutOfBounds) AllocatorContiguous<T>.shift<T>(mut AllocatorContiguous<T>* this) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    T out = this->ptr[0];
    this->len--;
    for (mut usize i = 0; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + 1];
    }
    return out;
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.shift_to<T>(Contiguous<T>* this, mut Contiguous<T>* out) {
    if (this->len == 0 || this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 1; i < this->len; i++) {
        out->ptr[i - 1] = this->ptr[i];
    }
    return this->ptr[0];
}

@export
fn (T | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.shift_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out) {
    if (this->len == 0) {
        return Error::OutOfBounds;
    }
    out->set_len(this->len - 1)?;
    for (mut usize i = 1; i < this->len; i++) {
        out->ptr[i - 1] = this->ptr[i];
    }
    return this->ptr[0];
}

@export
fn none AllocatorContiguous<T>.unshift<T>(mut AllocatorContiguous<T>* this, T value) {
    this->set_len(this->len + 1)?;
    for (mut usize i = 1; i < this->len; i++) {
        this->ptr[i] = this->ptr[i - 1];
    }
    this->ptr[0] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.unshift_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, T value) {
    if (this->len + 1 > out->len) {
        return Error::OutOfBounds;
    }
    out->ptr[0] = value;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn none Contiguous<T>.unshift_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, T value) {
    out->set_len(this->len + 1)?;
    out->ptr[0] = value;
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) AllocatorContiguous<T>.delete<T>(mut AllocatorContiguous<T>* this, ssize index) {
    usize index2 = this->resolve_index(index)?;
    this->len--;
    for (mut usize i = index2; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + 1];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.delete_to<T>(Contiguous<T>* this, mut Contiguous<T> value, ssize index) {
    usize index2 = this->resolve_index(index)?;
    if (this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index2; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index2; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.delete_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T> value, ssize index) {
    usize index2 = this->resolve_index(index)?;
    out->set_len(this->len - 1)?;
    for (mut usize i = 0; i < index2; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index2; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
}

@export
fn (none | Error::OutOfBounds) AllocatorContiguous<T>.delete_slice<T>(mut AllocatorContiguous<T>* this, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->len -= deleted;
    for (mut usize i = start; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.delete_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (this->len - deleted > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.delete_slice_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->set_len(this->len - deleted)?;
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (T | Error::OutOfBounds) AllocatorContiguous<T>.remove<T>(mut AllocatorContiguous<T>* this, ssize index) {
    usize index2 = this->resolve_index(index)?;
    this->len--;
    for (mut usize i = index2; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + 1];
    }
    return this->ptr[index2];
}

@export
fn (T | Error::OutOfBounds) Contiguous<T>.remove_to<T>(Contiguous<T>* this, mut Contiguous<T> value, ssize index) {
    usize index2 = this->resolve_index(index)?;
    if (this->len - 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index2; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index2; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
    return this->ptr[index2];
}

@export
fn (T | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.remove_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T> value, ssize index) {
    usize index2 = this->resolve_index(index)?;
    out->set_len(this->len - 1)?;
    for (mut usize i = 0; i < index2; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = index2; i < this->len; i++) {
        out->ptr[i] = this->ptr[i + 1];
    }
    return this->ptr[index2];
}

@export
fn (none | Error::OutOfBounds) AllocatorContiguous<T>.remove_slice<T>(mut AllocatorContiguous<T>* this, mut Contiguous<T>* out_slice, ssize start_index, ssize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (deleted > out_slice->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    this->len -= deleted;
    for (mut usize i = start; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.remove_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (deleted > out_slice->len || this->len - deleted > out->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.remove_slice_to_alloc<T>(Contiguous<T>* this, mut Contiguous<T>* out, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->set_len(this->len - deleted)?;
    if (deleted > out_slice->len) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) AllocatorContiguous<T>.remove_slice_alloc<T>(mut AllocatorContiguous<T>* this, mut AllocatorContiguous<T>* out_slice, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    out->set_len(deleted)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    this->len -= deleted;
    for (mut usize i = start; i < this->len; i++) {
        this->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.remove_slice_alloc_to<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out_slice, mut Contiguous<T>* out, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    if (this->len - deleted > out->len) {
        return Error::OutOfBounds;
    }
    out_slice->set_len(deleted)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.remove_slice_alloc_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, mut Contiguous<T>* out_slice, usize start_index, usize end_index) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    usize deleted = end - start;
    this->set_len(this->len - deleted)?;
    out_slice->set_len(deleted)?;
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        out_slice->ptr[loc] = this->ptr[i];
        loc++;
    }
    for (mut usize i = 0; i < start; i++) {
        out->ptr[i] = this->ptr[i];
    }
    for (mut usize i = start; i < this->len - deleted; i++) {
        out->ptr[i] = this->ptr[i + deleted];
    }
}

@export
fn T AllocatorContiguous<T>.concat<T>(mut AllocatorContiguous<T>* this, Contiguous<T>* values) {
    mut usize loc = this->len;
    this->set_len(this->len + values->len)?;
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[loc] = values->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.concat_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, Contiguous<T>* values) {
    if (this->len + values->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < this->len; i++) {
        out->ptr[i] = this->ptr[i];
    }
    mut usize loc = this->len;
    for (mut usize i = 0; i < values->len; i++) {
        out->ptr[loc] = values->ptr[i];
        loc++;
    }
}

@export
fn none Contiguous<T>.concat_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, T value) {
    out->set_len(this->len + values->len)?;
    for (mut usize i = 0; i < this->len; i++) {
