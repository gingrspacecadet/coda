@export
fn none AllocatorContiguous<T>.concat_start<T>(mut AllocatorContiguous<T>* this, Contiguous<T>* values) {
    mut usize loc = this->len;
    this->set_len(this->len + values->len)?;
    for (mut usize i = values->len; i < this->len; i++) {
        this->ptr[i] = this->ptr[i - values->len];
    }
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[i] = values->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.concat_start_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, Contiguous<T>* values) {
    if (this->len + values->len > out->len) {
