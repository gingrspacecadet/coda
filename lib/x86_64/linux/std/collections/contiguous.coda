}


@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) VarLenContiguous<T>.insert<T>(mut VarLenContiguous<T>* this, usize index, T value) {
    index = this->resolve_index(index)?;
    this->set_len(this->len + 1)?;
    for (mut usize i = index; i < this->len - 1; i++) {
        this->ptr[i + 1] = this->ptr[i];
    }
    this->ptr[index] = value;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.insert_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize index, T value) {
    index = this->resolve_index(index)?;
    if (this->len + 1 > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[index] = value;
    for (mut usize i = index; i < this->len - 1; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.insert_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, usize index, T value) {
    index = this->resolve_index(index)?;
    out->set_len(this->len + 1)?;
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    out->ptr[index] = value;
    for (mut usize i = index; i < this->len - 1; i++) {
        out->ptr[i + 1] = this->ptr[i];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) VarLenContiguous<T>.insert_slice<T>(mut VarLenContiguous<T>* this, usize index, Contiguous<T>* values) {
    index = this->resolve_index(index)?;
    usize old_len = this->len;
    this->set_len(this->len + values->len)?;
    for (mut usize i = old_len; i >= index; i--) {
        this->ptr[i + values->len] = this->ptr[i];
    }
    mut usize loc = index;
    for (mut usize i = 0; i < values->len; i++) {
        this->ptr[loc] = values->ptr[i];
        loc++;
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.insert_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize index, Contiguous<T>* values) {
    index = this->resolve_index(index)?;
    if (this->len + values->len > out->len) {
        return Error::OutOfBounds;
    }
    for (mut usize i = 0; i < index; i++) {
        out->ptr[i] = this->ptr[i];
    }
    mut usize loc = index;
    for (mut usize i = 0; i < values->len; i++) {
        out->ptr[loc] = values->ptr[i];
        loc++;
    }
    for (mut usize i = index; i < this->len - 1; i++) {
        out->ptr[i + values->len] = this->ptr[i];
    }
}

@export
fn (none | Error::AllocationFailed | Error::OutOfBounds) Contiguous<T>.insert_slice_to_var<T>(Contiguous<T>* this, mut VarLenContiguous<T>* out, usize index, Contiguous<T>* values) {
    index = this->resolve_index(index)?;
