                return Error::OutOfBounds;
            }
        }
    }
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_to_alloc<T>(Contiguous<T>* this, mut AllocatorContiguous<T>* out, (fn T(T value))* func) {
    for (mut usize i = 0; i < this->len; i++) {
        if (func(this->ptr[i])) {
            #inline(out->push(this->ptr[i]));
        }
    }
}

@export
fn none Contiguous<T>.filter_slice<T>(mut Contiguous<T>* this, usize start_index, usize end_index, (fn T(T value))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    mut usize deleted = 0;
    for (mut usize i = start; i < end; i++) {
        if (func(this->ptr[i])) {
            this->ptr[loc] = this->ptr[i];
            loc++;
        } else {
            deleted++;
        }
    }
    if (deleted > 0) {
        for (mut usize i = end; i < this->len; i++) {
            this->ptr[i - deleted] = this->ptr[i];
        }
    }
    this->len = loc;
}

@export
fn (none | Error::OutOfBounds) Contiguous<T>.filter_slice_to<T>(Contiguous<T>* this, mut Contiguous<T>* out, usize start_index, usize end_index, (fn T(T value))* func) {
    usize start = this->resolve_index(start_index)?;
    usize end = this->resolve_index(end_index)?;
    if (start > end) {
        return Error::OutOfBounds;
    }
    mut usize loc = 0;
    for (mut usize i = start; i < end; i++) {
        if (func(this->ptr[i])) {
            out->ptr[loc] = this->ptr[i];
            loc++;
            if (loc >= out->len) {
                return Error::OutOfBounds;
            }
        }
    }
}

