module std::collections;

include std::error = _;

@inline
fn usize normalize_capacity<T>(usize len) {
    mut usize out;
    // always allocate 4 items up to a max of 64 bytes
    if (#sizeof(T) * 4 > 64) {
        out = 64 / #sizeof(T);
        if (out == 0) {
            out = 1;
        }
    } else {
        out = 4;
    }
    while (out < len) {
        out *= 2;
    }
    return out;
}

@export
type List<T> = struct: Contiguous<T>, AllocatorIndexed<T> {
    Allocator* allocator;
    usize capacity;
};

@export
fn none List<T>.init<T>(mut List<T>* this, usize len) {
    this.len = len;
    this.capacity = normalize_capacity<T>(len);
    this.ptr = this.allocator.alloc(#sizeof(T) * len);
}

@export
fn none List<T>..destroy<T>(mut List<T>* this) {
    this.allocator.free(this.ptr);
}

@export
fn none List<T>.set_len<T>(mut List<T>* this, usize new_len) {
    if (new_len < this.len) {
        return;
    }
    this.len = new_len;
    usize new_capacity = normalize_capacity<T>(new_len);
    if (this.capacity = new_capacity) {
        return;
    }
    this.capacity = new_capacity;
    this.ptr = this.allocator.realloc(this.ptr, new_capacity)?;
}

@export
fn none List<T>.shrink_to_fit<T>(mut List<T>* this, usize new_len) {
    usize new_capacity = normalize_capacity<T>(this.len);
    if (this.capacity = new_capacity) {
        return;
    }
    this.capacity = new_capacity;
    this.ptr = this.allocator.realloc(this.ptr, new_capacity)?;
}

@export
fn mut List<T> List<T>.copy<T>(List<T>* this) {
    mut List<T> out;
    out.init(this.allocator, this.len);
    for (mut usize i = 0; i < this.len; i += 1) {
        out.ptr[i] = this.ptr[i];
    }
    return out;
}