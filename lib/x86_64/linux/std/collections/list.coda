module std::collections;

include std::error::Error : Error;
include std::mem : _;

@inline
fn usize normalize_capacity<T>(usize len) {
    mut usize out;
    // always allocate 4 items up to a max of 64 bytes
    if (#sizeof(T) * 4 > 64) {
        out = 64 / #sizeof(T);
        if (out == 0) {
            out = 1;
        }
    } else {
        out = 4;
    }
    while (out < len) {
        out *= 2;
    }
    return out;
}

@export
type List<T> = struct: VarLenContiguous<T> {
    Allocator* allocator;
    usize len;
    usize capacity;
    T* data;
}

@export
fn none List<T>.init<T>(mut List<T>* this, usize len) {
    this->len = len;
    this->capacity = normalize_capacity<T>(len);
    this->data = this->allocator->alloc<T>(len);
}

@export
fn none List<T>..destroy<T>(mut List<T>* this) {
    this->allocator->free(this->data);
}

@export
fn none List<T>.set_len(mut List<T>* this, usize new_len) {
    if (new_len < this->len) {
        return;
    }
    this->len = new_len;
    usize new_capacity = normalize_capacity<T>(new_len);
    if (this->capacity = new_capacity) {
        return;
    }
    this->capacity = new_capacity;
    this->data = this->allocator->realloc(this->data, new_capacity)?;
}

@export
fn none List<T>.shrink_to_fit(mut List<T>* this, usize new_len) {
    usize new_capacity = normalize_capacity<T>(this->len);
    if (this->capacity = new_capacity) {
        return;
    }
    this->capacity = new_capacity;
    this->data = this->allocator->realloc(this->data, new_capacity)?;
}