module std::collections;

@export
constraint Indexed<T>: Sized<T> = {
    fn T get(Sized<T>* this, ssize index);
    fn T set(mut Sized<T>* this, ssize index, T value);
};

@export
constraint AllocatorIndexed<T>: Indexed<T> = {
    Allocator* allocator;
    usize capacity;
    fn none init(mut AllocatorIndexed* this, Allocator* allocator, usize len);
    fn none destroy();
    fn none set_len(mut AllocatorIndexed* this, usize new_len);
    fn none shrink_to_fit(mut AllocatorIndexed* this);
    fn mut AllocatorIndexed copy(AllocatorIndexed* this);
};

@export
@inline
fn (usize | Error::OUT_OF_BOUNDS) Indexed<T>.resolve_index(Indexed<T>* this, ssize index) {
    if (index < 0) {
        index += this.len;
        if (index < 0) {
            return Error::OUT_OF_BOUNDS;
        }
    } else if (index >= this.len) {
        return Error::OUT_OF_BOUNDS;
    }
    return (usize)index;
}

@export
@inline
fn usize Indexed<T>.clamp_index(Indexed<T>* this, ssize index) {
    if (index < 0) {
        index += this.len;
        if (index < 0) {
            return 0;
        } else {
            return (usize)index;
        }
    } else if (index >= this.len) {
        return this.len - 1;
    } else {
        return (usize)index;
    }
}