module std::collections;

include std::error::Error : Error;
include std::mem : _;

@export
constraint Node<T> = {
    Node*? next;
    T value;
};

@export
type SingleNode<T> = struct: Node<T> {
    SingleNode*? next;
    T value;
};

@export
type DoubleNode<T> = struct: Node<T> {
    DoubleNode*? prev;
    DoubleNode*? next;
    T value;
};

@export
constraint SingleLinked<T>: AllocatorIndexed<T> = {
    Node<T>* first;
    Node<T>* last;
};

@export
constraint DoubleLinked<T>: AllocatorIndexed<T> = {
    DoubleNode<T>* first;
    DoubleNode<T>* last;
};