module std::types::typeid;

include std::error = _;
include std::mem = _;
include std::format = _;

@export
type TypeKind = enum: uint8 {
    NONE = 0x00,
    NULL = 0x01,
    BOOL = 0x02,
    INT8 = 0x03,
    INT16 = 0x04,
    INT32 = 0x05,
    INT64 = 0x06,
    UINT8 = 0x07,
    UINT16 = 0x08,
    UINT32 = 0x09,
    UINT64 = 0x0a,
    SSIZE = 0x0b,
    USIZE = 0x0c,
    FLOAT16 = 0x0d,
    FLOAT32 = 0x0e,
    FLOAT64 = 0x0f,
    ANY = 0x10,
    INTRINSIC = 0x11,
    POINTER = 0x12,
    ARRAY = 0x13,
    FUNCTION = 0x14,
    STRUCT = 0x15,
    UNION = 0x16,
    ENUM = 0x17,
    SUM = 0x18,
};

@export
type TypeFlags: enum: uint8 {
    NAMED = 1,
    MUTABLE = 2,
    GENERIC = 4,
    POINTER_MUTABLE = 16,
    POINTER_OPTIONAL = 32,
    ARRAY_MUTABLE = 16,
    FUNCTION_NAMED = 16,
    FUNCTION_GENERIC = 32,
};

// all of the @alignas(0) are probably not neccessary
// i'm just putting it there to make sure

// the other nonzero @alignas are neccessary though
// to prevent the compiler from inserting holes

@export
type IntrinsicTypeData = struct {
    @alignas(0)
    string* name;
};

@export
type PointerTypeData = struct {
    @alignas(0)
    Type* to;
};

@export
type ArrayTypeData = struct {
    @alignas(0)
    Type* of;
    @alignas(#sizeof(Type*))
    usize*? len;
};

@export
type FunctionParameterTypeData = struct {
    @alignas(0)
    string* name;
    @alignas(#sizeof(string*))
    Type* type_;
};

@export
type FunctionNonNamedNonGenericTypeData = struct {
    @alignas(0)
    Type* return_type;
    @alignas(#sizeof(Type*))
    FunctionParameterData[] params;
};

@export
type FunctionNonNamedGenericTypeData = struct {
    @alignas(0)
    Type* return_type;
    @alignas(#sizeof(Type*))
    string*[] generic_names;
    @alignas(#sizeof(Type*) + #sizeof(string*[]))
    FunctionParameterData[] params;
};

@export
type FunctionNamedNonGenericTypeData = struct {
    @alignas(0)
    Type* return_type;
    @alignas(#sizeof(Type*))
    string* name;
    @alignas(#sizeof(Type*) + #sizeof(string*))
    FunctionParameterData[] params;
};

@export
type FunctionNamedGenericTypeData = struct {
    @alignas(0)
    Type* return_type;
    @alignas(#sizeof(Type*))
    string* name;
    @alignas(#sizeof(Type*) + #sizeof(string*))
    string*[] generic_names;
    @alignas(#sizeof(Type*) + #sizeof(string*) + #sizeof(string*[]))
    FunctionParameterData[] params;
};

@export
type StructMemberTypeData = struct {
    @alignas(0)
    string* name;
    @alignas(#sizeof(string*))
    Type* type_;
    @alignas(#sizeof(string*) + #sizeof(Type*))
    usize offset;
};

@export
type StructTypeData = struct {
    @alignas(0)
    usize size;
    @alignas(#sizeof(usize))
    #type[] inherits_from;
    @alignas(#sizeof(usize) + #sizeof(#type[]))
    StructMemberTypeData[] members;
};

@export
type UnionMemberTypeData = struct {
    @alignas(0)
    string* name;
    @alignas(#sizeof(string*))
    Type* type_;
    @alignas(#sizeof(string*) + #sizeof(Type*))
    usize offset;
};

@export
type UnionTypeData = struct {
    @alignas(0)
    usize size;
    @alignas(#sizeof(usize))
    #type[] inherits_from;
    @alignas(#sizeof(usize))
    UnionMemberTypeData[] members;
};

@export
type EnumMemberTypeData = struct {
    @alignas(0)
    string* name;
    @alignas(#sizeof(string*))
    // placeholder, only for #offsetof usage etc
    uint8 value;
};

@export
type EnumTypeData = struct {
    @alignas(0)
    Type* backing_type;
    @alignas(0);
    EnumMemberTypeData[] members;
};

@export
type SumTypeData = struct {
    @alignas(0)
    usize size;
    @alignas(#sizeof(usize))
    Type*[] members;
};

@export
type ExtraTypeData = union {
    @alignas(0)
    IntrinsicTypeData intrinsic;
    @alignas(0)
    PointerTypeData pointer;
    @alignas(0)
    ArrayTypeData array;
    @alignas(0)
    FunctionNonNamedNonGenericTypeData* function_non_named_non_generic;
    @alignas(0)
    FunctionNonNamedGenericTypeData* function_non_named_non_generic;
    @alignas(0)
    FunctionNamedNonGenericTypeData* function_named_non_generic;
    @alignas(0)
    FunctionNamedGenericTypeData* function_named_generic;
    @alignas(0)
    StructTypeData* struct_;
    @alignas(0)
    UnionTypeData* union_;
    @alignas(0)
    EnumTypeData* enum_;
    @alignas(0)
    SumTypeData* sum;
};

@export
type Type = struct {
    @alignas(0)
    TypeKind kind;
    @alignas(#sizeof(TypeKind))
    TypeFlags flags;
    @alignas(#sizeof(TypeKind) + #sizeof(TypeFlags))
    union {
        struct {
            @alignas(0)
            ExtraTypeData* data;
        } non_named_non_generic;
        struct {
            @alignas(0)
            string*[] generic_names;
            @alignas(#sizeof(string*[]))
            ExtraTypeData* data;
        } non_named_generic;
        struct {
            @alignas(0)
            string* name;
            @alignas(#sizeof(string*))
            ExtraTypeData* data;
        } named_non_generic;
        struct {
            @alignas(0)
            string* name;
            @alignas(#sizeof(string*))
            string*[] generic_names;
            @alignas(#sizeof(string*) + #sizeof(string*[]))
            ExtraTypeData* data;
        } named_generic;
    };
};

@export
@inline
fn bool Type.is_named(Type* this) {
    return this.flags & TypeFlags::NAMED;
}

@export
@inline
fn bool Type.is_mutable(Type* this) {
    return this.flags & TypeFlags::MUTABLE;
}

@export
@inline
fn bool Type.is_generic(Type* this) {
    return this.flags & TypeFlags::GENERIC;
}

@export
@inline
fn bool Type.is_pointer_mutable(Type* this) {
    return this.flags & TypeFlags::POINTER_MUTABLE;
}

@export
@inline
fn bool Type.is_pointer_optional(Type* this) {
    return this.flags & TypeFlags::POINTER_OPTIONAL;
}

@export
@inline
fn bool Type.is_array_mutable(Type* this) {
    return this.flags & TypeFlags::ARRAY_MUTABLE;
}

@export
@inline
fn bool Type.is_function_generic(Type* this) {
    return this.flags & TypeFlags::FUNCTION_GENERIC;
}

@export
fn (string* | Error::TYPE_IS_NOT_NAMED) Type.get_name(Type* this) {
    if (this.is_named()) {
        if (this.is_generic()) {
            return this.named_generic.name;
        } else {
            return this.named_non_generic.name;
        }
    } else {
        return Error::TYPE_IS_NOT_NAMED;
    }
}

@export
fn (string*[] | Error::TYPE_IS_NOT_GENERIC) Type.get_generic_names(Type* this) {
    if (this.is_generic()) {
        if (this.is_named()) {
            return this.named_generic.generic_names;
        } else {
            return this.non_named_generic.generic_names;
        }
    }
}

@export
fn (none | ExtraTypeData*) Type.get_extra_data(Type* this) {
    if (this.flags & TypeFlags::NAMED) {
        if (this.flags & TypeFlags::GENERIC) {
            return &this.named_generic.data;
        } else {
            return &this.named_non_generic.data;
        }
    } else {
        if (this.flags & TypeFlags::GENERIC) {
            return &this.non_named_generic.data;
        } else {
            return &this.non_named_non_generic.data;
        }
    }
}

@export
fn usize Type.get_size(Type* this) {
    if (this.kind == TypeKind::NONE) {
        return #sizeof(none);
    } else if (this.kind == TypeKind::NULL) {
        return #sizeof(type*);
    } else if (this.kind == TypeKind::BOOL) {
        return #sizeof(bool);
    } else if (this.kind == TypeKind::INT8) {
        return #sizeof(int8);
    } else if (this.kind == TypeKind::INT16) {
        return #sizeof(int16);
    } else if (this.kind == TypeKind::INT32) {
        return #sizeof(int32);
    } else if (this.kind == TypeKind::INT64) {
        return #sizeof(int64);
    } else if (this.kind == TypeKind::UINT8) {
        return #sizeof(uint8);
    } else if (this.kind == TypeKind::UINT16) {
        return #sizeof(uint16);
    } else if (this.kind == TypeKind::UINT32) {
        return #sizeof(uint32);
    } else if (this.kind == TypeKind::UINT64) {
        return #sizeof(uint64);
    } else if (this.kind == TypeKind::SSIZE) {
        return #sizeof(ssize);
    } else if (this.kind == TypeKind::USIZE) {
        return #sizeof(usize);
    } else if (this.kind == TypeKind::FLOAT16) {
        return #sizeof(float16);
    } else if (this.kind == TypeKind::FLOAT32) {
        return #sizeof(float32);
    } else if (this.kind == TypeKind::FLOAT64) {
        return #sizeof(float64);
    } else if (this.kind == TypeKind::ANY) {
        return #sizeof(any);
    } else if (this.kind == TypeKind::INTRINSIC) {
        // todo
        fatal_error("Fatal error: Cannot take size of intrinsic");
    } else if (this.kind == TypeKind::POINTER) {
        return #sizeof(none*);
    } else if (this.kind == TypeKind::ARRAY) {
        return #sizeof(int32[]);
    } else if (this.kind == TypeKind::FUNCTION) {
        return #sizeof(none*);
    } else if (this.kind == TypeKind::STRUCT) {
        return this.get_extra_data().struct_.size;
    } else if (this.kind == TypeKind::UNION) {
        return this.get_extra_data().union_.size;
    } else if (this.kind == TypeKind::ENUM) {
        return this.get_extra_data().enum_.backing_type.get_size();
    } else if (this.kind == TypeKind::SUM) {
        return this.get_extra_data().sum.size;
    } else {
        fatal_error("Fatal error: Invalid typeid kind");
    }
}