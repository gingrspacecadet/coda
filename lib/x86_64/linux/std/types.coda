module std::types;

@export
constraint Signed = int8 || int16 || int32 || int64;
@export
constraint Unsigned = uint8 || uint16 || uint32 || uint64;
@export
constraint Integral = AnyInt || AnyUint;
@export
constraint Float = float32 || float64;
@export
constraint Number = Integral || Float;

@export
uint8 UINT8_MAX = 0xff;
@export
uint16 UINT16_MAX = 0xffff;
@export
uint32 UINT32_MAX = 0xffffffff;
@export
uint64 UINT64_MAX = 0xffffffffffffffff;

@export
int8 INT8_MIN = -0x80;
@export
int8 INT8_MAX = 0x7f;

@export
int16 INT16_MIN = -0x8000;
@export
int16 INT16_MAX = 0x7fff;

@export
int32 INT32_MIN = -0x80000000;
@export
int32 INT32_MAX = 0x7fffffff;

@export
int64 INT64_MIN = -0x8000000000000000;
@export
int64 INT64_MAX = 0x7fffffffffffffff;