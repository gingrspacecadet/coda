module std::string;

include std::types : _;

fn bool string.contains(string this, string that);

fn bool string.starts_with(string this, string that);
fn bool string.ends_with(string this, string that);

fn string[] string.split(string this, string separator);

fn string string.trim(string this);

fn bool char.is_alpha(char this);
fn bool char.is_digit(char this);
fn bool char.is_space(char this);