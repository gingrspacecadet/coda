module std::fmt;

include std::io;

interface Display {
    fn none | std::io::IOError format(mut std::io::Writer writer);
}

interface Debug {
    fn none | std::io::IOError debug(mut std::io::Writer writer);
}

fn none write(mut std::io::Writer writer, string fmt, any[] args);

fn string format(std::mem::Allocator alloc, string fmt, any[] args);