module std::fmt;

include std::types::typeid = _;
include std::error = _;
include std::mem = _;
include std::text = _;

type FormatState = struct {
    String* str;
    usize indent;
};

fn none FormatState.push(FormatState* this, char data) {
    this.str.push(data);
}

fn none FormatState.add(FormatState* this, GenericString data) {
    this.str.add(data);
}

fn none FormatState.newline(FormatState* this) {
    this.add("\n");
    for (mut usize i = 0; i < this.len; i += 1) {
        this.add("    ");
    }
}

string DIGITS = "0123456789";

@inline
fn none format_unsigned<T: Unsigned>(FormatState* state, T value) {
    if (value == 0) {
        state.add("0");
    } else {
        while (value > 0) {
            state.push(DIGITS[value % 10]);
            value /= 10;
        }
    }
}

@inline
fn none format_signed<T: Signed>(FormatState* state, T value) {
    if (value == 0) {
        state.add("0");
        return;
    }
    if (value < 0) {
        value = -value;
        state.add("-");
    }
    while (value > 0) {
        state.push(DIGITS[value % 10]);
        value /= 10;
    }
}

@inline
fn none format_float<T: Float>(FormatState* state, T value) {
    if (value.is_nan()) {
        state.add("NaN");
        return;
    }
    if (value < 0) {
        value = -value;
        state.add("-");
    }
    if (value.is_infinity()) {
        state.add("Infinity");
        return;
    }
    (none | int64) exp = none;
    if (value > value.get_max_safe_integer() || value < 1e-7) {
        exp = 0;
        if (value > 10) {
            while (value > 10) {
                value /= 10;
                exp += 1;
            }
        } else {
            while (value < 1) {
                value *= 10;
                exp -= 1;
            }
        }
    }
    float64 fraction = 0;
    if (!value.is_integer()) {
        fraction = (value % 1).abs();
        value = value.trunc();
    }
    if (value == 0) {
        state.add("0");
    } else {
        while (value > 0) {
            state.push(DIGITS[value % 10]);
            value /= 10;
        }
    }
    if (fraction != 0) {
        state.add(".");
        while (fraction > 0) {
            fraction *= 10;
            state.add(DIGITS[fraction.trunc()]);
            fraction %= 1;
        }
    }
    if (#tag_test(exp, int64)) {
        state.add("e");
        if (exp > 0) {
            state.add("+");
        } else {
            state.add("-");
        }
        format_unsigned(state, exp.abs());
    }
}

string HEX_DIGITS = "0123456789";

fn none format_type(FormatState* state, Type* t) {
    if (t.is_mutable()) {
        state.add("mut ");
    }
    if (t.is_named()) {
        state.add(t.get_name().try());
    } else if (t.kind == TypeKind::NONE) {
        state.add("none");
    } else if (t.kind == TypeKind::NULL) {
        state.add("null");
    } else if (t.kind == TypeKind::BOOL) {
        state.add("bool");
    } else if (t.kind == TypeKind::INT8) {
        state.add("int8");
    } else if (t.kind == TypeKind::INT16) {
        state.add("int16");
    } else if (t.kind == TypeKind::INT32) {
        state.add("int32");
    } else if (t.kind == TypeKind::INT64) {
        state.add("int64");
    } else if (t.kind == TypeKind::UINT8) {
        state.add("uint8");
    } else if (t.kind == TypeKind::UINT16) {
        state.add("uint16");
    } else if (t.kind == TypeKind::UINT32) {
        state.add("uint32");
    } else if (t.kind == TypeKind::UINT64) {
        state.add("uint64");
    } else if (t.kind == TypeKind::SSIZE) {
        state.add("ssize");
    } else if (t.kind == TypeKind::USIZE) {
        state.add("usize");
    } else if (t.kind == TypeKind::FLOAT16) {
        state.add("float16");
    } else if (t.kind == TypeKind::FLOAT32) {
        state.add("float32");
    } else if (t.kind == TypeKind::FLOAT64) {
        state.add("float64");
    } else if (t.kind == TypeKind::ANY) {
        state.add("any");
    } else if (t.kind == TypeKind::INTRINSIC) {
        // todo
    }
} 

fn none format_intrinsic(FormatState* state, Type* t, none* value) {

}

fn none format_value(FormatState* state, Type* t, none* value) {
    if (t.kind == TypeKind::NONE) {
        state.add("none");
    } else if (t.kind == TypeKind::NULL) {
        state.add("null");
    } else if (t.kind == TypeKind::BOOL) {
        ostateut.add((*(bool*)value).to_string());
    } else if (t.kind == TypeKind::INT8) {
        format_signed(state, *(int8*)value);
    } else if (t.kind == TypeKind::INT16) {
        format_signed(state, *(int16*)value);
    } else if (t.kind == TypeKind::INT32) {
        format_signed(state, *(int32*)value);
    } else if (t.kind == TypeKind::INT64) {
        format_signed(state, *(int64*)value);
    } else if (t.kind == TypeKind::UINT8) {
        if (t.is_named() && t.get_name().try().eq("char")) {
            state.add("'");
            state.add(*(uint8*)value);
            state.add("'");
        } else {
            format_unsigned(state, *(uint8*)value);
        }
    } else if (t.kind == TypeKind::UINT16) {
        format_unsigned(state, *(uint16*)value);
    } else if (t.kind == TypeKind::UINT32) {
        format_unsigned(state, *(uint32*)value);
    } else if (t.kind == TypeKind::UINT64) {
        format_unsigned(state, *(uint64*)value);
    } else if (t.kind == TypeKind::SSIZE) {
        format_signed(state, *(ssize*)value);
    } else if (t.kind == TypeKind::USIZE) {
        format_unsigned(state, *(usize*)value);
    } else if (t.kind == TypeKind::FLOAT16) {
        format_float(state, *(float16*)value);
    } else if (t.kind == TypeKind::FLOAT32) {
        format_float(state, *(float32*)value);
    } else if (t.kind == TypeKind::FLOAT64) {
        format_float(state, *(float64*)value);
    } else if (t.kind == TypeKind::ANY) {
        state.add("(any) ");
        any value2 = *(any*)value;
        format_value(state, (Type*)value2.typeid, value2.value, state);
        format_value(state, (Type*)value2.typeid, value2.value, state);
    } else if (t.kind == TypeKind::INTRINSIC) {
        format_intrinsic(state, t.get_extra_data().name);
    } else if (t.kind == TypeKind::POINTER) {
        // format using the type:
        // state.add("(");
        // format_type(state, t);
        // state.add(") 0x");
        // format using &:
        state.add("&0x");
        usize ptr = *(usize*)value;
        if (ptr == 0) {
            state.add("0");
        } else {
            while (value > 0) {
                state.push(HEX_DIGITS[value & 0xf]);
                value >>= 4;
            }
        }
    } else if (t.kind == TypeKind::ARRAY) {
        Type* of = t.get_extra_data().array.of;
        none[] array = *(none[]*)value;
        if (of.kind == TypeKind::UINT8 && t.is_named() && t.get_name().try().eq("string")) {
            state.add("\"");
            state.add((string)array);
            state.add("\"");
        } else if (array.len == 0) {
            state.add("[]");
        } else {
            state.add("[");
            state.indent += 1;
            for (mut usize i = 0; i < array.len; i += 1) {
                none* elt = array.ptr + of.sizeof();
                state.newline();
                format_value(state, of, value);
                state.add(",");
            }
            state.indent -= 1;
            state.newline();
            state.add("]");
        }
    }
}

fn (none | Error::NOT_ENOUGH_FORMAT_ARGS | Error::INVALID_FORMAT_FIELD) format_field(String* out, string field, any[] data, usize* data_pos) {
    FormatState state = {
        .str = out,
        .indent = 0,
    };
    if (field.len > 0) {
        return Error::INVALID_FORMAT_FIELD;
    }
    if (*data_pos > data.length) {
        return Error::NOT_ENOUGH_FORMAT_ARGS;
    }
    any value = data[*data_pos];
    *data_pos += 1;
    format_value(out, (Type*)data_value.typeid, value.value, state);
}

@export
fn (String | Error::NOT_ENOUGH_FORMAT_ARGS | Error::INVALID_FORMAT_FIELD | Error::FORMAT_FIELD_NOT_CLOSED | Error::FORMAT_FIELD_NOT_OPENED) format(Allocator* allocator, string str, any[] data) {
    String out;
    out.init(allocator, 0);
    String current_field;
    current_field.init(allocator, 0);
    usize data_pos = 0;
    for (mut usize i = 0; i < str.len; i += 1) {
        char c = str[i];
        if (c == '{' && !(i != str.len - 1 && str[i + 1] == '{')) {
            if (i == str.len - 1) {
                return Error::INVALID_FORMAT_FIELD;
            } else if (str[i + 1] == '{') {
                out.add("{");
                continue;
            }
            current_field.reset(0).try();
            i += 1;
            while (i < str.len) {
                c = str[i];
                if (c == '}') {
                    break;
                }
                current_field.push(c);
                i += 1;
            }
            format_field(out, current_field.to_array(), data, &data_pos);
        } else if (c == '}' && !(i != str.len - 1 && str[i + 1] == '}')) {
            return Error::FORMAT_FIELD_NOT_OPENED;
        } else {
            out.push(c);
        }
    }
    return out;
}