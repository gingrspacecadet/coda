module std::fmt;

include std
include std::types::typeid = _;
include std::error = _;
include std::mem = mem;
include std::text = _;

type FormatConfig = struct {
};

type Formatter = struct: String {
    FormatConfig config;
    any[] data;
    usize indent;
};

@inline
fn none Formatter.newline(mut Formatter* this) {
    this.add("\n");
    for (mut usize i = 0; i < this.len; i += 1) {
        this.add("    ");
    }
}

string DIGITS = "0123456789";
string HEX_DIGITS = "0123456789abcdef";

@inline
fn none Formatter.unsigned<T: Unsigned>(mut Formatter* this, T value) {
    if (value == 0) {
        this.add("0");
    } else {
        while (value > 0) {
            this.push(DIGITS[value % 10]);
            value /= 10;
        }
    }
}

@inline
fn none Formatter.signed<T: Signed>(mut Formatter* this, T value) {
    if (value == 0) {
        this.add("0");
        return;
    }
    if (value < 0) {
        value = -value;
        this.add("-");
    }
    while (value > 0) {
        this.push(DIGITS[value % 10]);
        value /= 10;
    }
}

@inline
fn none Formatter.float<T: Float>(mut Formatter* this, T value) {
    if (value.is_nan()) {
        this.add("NaN");
        return;
    }
    if (value < 0) {
        value = -value;
        this.add("-");
    }
    if (value.is_infinity()) {
        this.add("Infinity");
        return;
    }
    (none | int64) exp = none;
    if (value > value.get_max_safe_integer() || value < 1e-7) {
        exp = 0;
        if (value > 10) {
            while (value > 10) {
                value /= 10;
                exp += 1;
            }
        } else {
            while (value < 1) {
                value *= 10;
                exp -= 1;
            }
        }
    }
    float64 fraction = 0;
    if (!value.is_integer()) {
        fraction = (value % 1).abs();
        value = value.trunc();
    }
    if (value == 0) {
        this.add("0");
    } else {
        while (value > 0) {
            this.push(DIGITS[value % 10]);
            value /= 10;
        }
    }
    if (fraction != 0) {
        this.add(".");
        while (fraction > 0) {
            fraction *= 10;
            this.add(DIGITS[fraction.trunc()]);
            fraction %= 1;
        }
    }
    if (#tag_test(exp, int64)) {
        this.add("e");
        if (exp > 0) {
            this.add("+");
        } else {
            this.add("-");
        }
        this.unsigned(exp.abs());
    }
}


fn bool Formatter.try_name(mut Formatter* this, Type* t, bool space_after) {
    if (this.is_named()) {
        if (t.is_generic()) {
            string*[] generic_names = t.get_generic_names().try();
            this.add("<");
            for (mut usize i = 0; i < generic_names.len; i += 1) {
                this.add(generic_names[i]);
                if (i != generic_names.len - 1) {
                    this.add(", ");
                }
            }
            this.add(">");
        }
        if (space_after) {
            this.add(" ");
        }
        return true;
    } else {
        return false;
    }
}

fn none Formatter.type_(mut Formatter* this, Type* t) {
    if (t.is_mutable()) {
        this.add("mut ");
    }
    if (this.try_name(t, false)) {
        // do nothing, the function handles it
    } else if (t.kind == TypeKind::NONE) {
        this.add("none");
    } else if (t.kind == TypeKind::NULL) {
        this.add("null");
    } else if (t.kind == TypeKind::BOOL) {
        this.add("bool");
    } else if (t.kind == TypeKind::INT8) {
        this.add("int8");
    } else if (t.kind == TypeKind::INT16) {
        this.add("int16");
    } else if (t.kind == TypeKind::INT32) {
        this.add("int32");
    } else if (t.kind == TypeKind::INT64) {
        this.add("int64");
    } else if (t.kind == TypeKind::UINT8) {
        this.add("uint8");
    } else if (t.kind == TypeKind::UINT16) {
        this.add("uint16");
    } else if (t.kind == TypeKind::UINT32) {
        this.add("uint32");
    } else if (t.kind == TypeKind::UINT64) {
        this.add("uint64");
    } else if (t.kind == TypeKind::SSIZE) {
        this.add("ssize");
    } else if (t.kind == TypeKind::USIZE) {
        this.add("usize");
    } else if (t.kind == TypeKind::FLOAT16) {
        this.add("float16");
    } else if (t.kind == TypeKind::FLOAT32) {
        this.add("float32");
    } else if (t.kind == TypeKind::FLOAT64) {
        this.add("float64");
    } else if (t.kind == TypeKind::ANY) {
        this.add("any");
    } else if (t.kind == TypeKind::INTRINSIC) {
        // todo
        this.add("<intrinsic type>");
    } else if (t.kind == TypeKind::POINTER) {
        this.type_(t.get_extra_data().pointer.to);
        if (this.is_pointer_mutable()) {
            this.add(" mut");
        }
        this.add("*");
        if (this.is_pointer_optional()) {
            this.add("?");
        }
    } else if (t.kind == TypeKind::ARRAY) {
        this.type_(t.get_extra_data().array.of);
        if (this.is_array_mutable()) {
            this.add(" mut");
        }
        this.add("[]");
    } else if (t.kind == TypeKind::FUNCTION) {
        this.add("(fn ");
        FunctionParameterTypeData[] params;
        // i'll deal with this not being up to date later
        if (this.is_function_generic()) {
            FunctionGenericTypeData* extra = &t.get_extra_data().function_generic;
            this.type_(extra.return_type);
            this.add("<");
            for (mut usize i = 0; i < extra.generic_names.len; i += 1) {
                this.add(extra.generic_names[i]);
                if (i != extra.generic_names.len - 1) {
                    this.add(", ");
                }
            }
            this.add(">");
            params = extra.params;
        } else {
            FunctionNonGenericTypeData* extra = &t.get_extra_data().function_non_generic;
            this.type_(extra.return_type);
            params = extra.params;
        }
        this.add("(");
        for (mut usize i = 0; i < params.len; i += 1) {
            this.type_(params[i].name);
            this.add(" ");
            this.type_(params[i].type_);
        }
        this.add("))");
    } else if (t.kind == TypeKind::STRUCT) {
        this.add("struct");
        StructTypeData* extra = &t.get_extra_data().struct_;
        if (extra.inherits_from.len > 0) {
            this.add(": ");
            for (mut usize i = 0; i < extra.inherits_from.len; i++) {
                this.add("");
            }
        }
        this.add(" {");
        this.indent += 1;
        for (mut usize i = 0; i < extra.members.len; i += 1) {
            StructMemberTypeData* member = &extra.members[i];
            this.newline();
            this.add(member.type_);
            this.add(" ");
            this.add(member.name);
            this.add(";");
        }
        this.indent -= 1;
        this.newline();
        this.add("}");
    } else if (t.kind == TypeKind::UNION) {
        this.add("union");
        // UnionTypeData* extra = &t.get_extra_data().struct_;
        // if (extra.inherits_from.len > 0) {
        //     this.add(": ");
        //     for (mut usize i = 0; i < extra.inherits_from.len; i++) {
        //         this.add("");
        //     }
        // }
        this.add(" {");
        this.indent += 1;
        for (mut usize i = 0; i < extra.members.len; i += 1) {
            UnionMemberTypeData* member = &extra.members[i];
            this.newline();
            this.add(member.type_);
            this.add(" ");
            this.add(member.name);
            this.add(";");
        }
        this.indent -= 1;
        this.newline();
        this.add("}");
    } else if (t.kind == TypeKind::ENUM) {
        this.add("enum: ");
        EnumTypeData* extra = &t.get_extra_data().enum_;
        this.type_(extra.backing_type);
        this.add(" {");
        this.indent += 1;
        for (mut usize i = 0; i < extra.members.len; i += 1) {
            EnumMemberTypeData* member = &extra.members[i];
            this.newline();
            this.add(member.name);
            this.add(" = ");
            this.value(extra.backing_type, &member.value);
            this.add(",");
        }
        this.indent -= 1;
        this.newline();
        this.add("}");
    } else if (t.kind == TypeKind::SUM) {
        this.add("(");
        Type*[] members = &t.get_extra_data().sum.members;
        for (mut usize i = 0; i < members.len; i += 1) {
            this.type_(members[i]);
            if (i != members.len - 1) {
                this.add(" | ");
            }
        }
        this.add(")");
    } else {
        fatal_error("Fatal error: Invalid typeid kind");
    }
}

@inline
fn none Formatter.intrinsic(mut Formatter* this, Type* t, none* value) {
    // todo
    this.add("<intrinsic type>");
}

@inline
fn none Formatter.char_(mut Formatter* this, char c) {
    if (c == '\\') {
        this.add('\\\\');
    } else if (c == '"') {
        this.add('\\"');
    } else if (c == '\'') {
        this.add('\\\'');
    } else if (c == '\n') {
        this.add('\\n');
    } else if (c == '\r') {
        this.add('\\r');
    } else if (c == '\t') {
        this.add('\\t');
    } else if (c == '\0') {
        this.add('\\0');
    } else if (c.is_printable()) {
        this.add(c);
    } else {
        this.add("\\x");
        this.push(HEX_DIGITS[c >> 4]);
        this.push(HEX_DIGITS[c & 0xf]);
    }
}

fn none Formatter.value(mut Formatter* this, Type* t, none* value) {
    if (t.kind == TypeKind::NONE) {
        this.add("none");
    } else if (t.kind == TypeKind::NULL) {
        this.add("null");
    } else if (t.kind == TypeKind::BOOL) {
        this.add((*(bool*)value).to_string());
    } else if (t.kind == TypeKind::INT8) {
        this.signed(*(int8*)value);
    } else if (t.kind == TypeKind::INT16) {
        this.signed(*(int16*)value);
    } else if (t.kind == TypeKind::INT32) {
        this.signed(*(int32*)value);
    } else if (t.kind == TypeKind::INT64) {
        this.signed(*(int64*)value);
    } else if (t.kind == TypeKind::UINT8) {
        if (t.is_named() && t.get_name().try().eq("char")) {
            this.add("'");
            this.char_(*(char*)value);
            this.add("'");
        } else {
            this.unsigned(*(uint8*)value);
        }
    } else if (t.kind == TypeKind::UINT16) {
        this.unsigned(*(uint16*)value);
    } else if (t.kind == TypeKind::UINT32) {
        this.unsigned(*(uint32*)value);
    } else if (t.kind == TypeKind::UINT64) {
        this.unsigned(*(uint64*)value);
    } else if (t.kind == TypeKind::SSIZE) {
        this.signed(*(ssize*)value);
    } else if (t.kind == TypeKind::USIZE) {
        this.unsigned(*(usize*)value);
    } else if (t.kind == TypeKind::FLOAT16) {
        this.float(*(float16*)value);
    } else if (t.kind == TypeKind::FLOAT32) {
        this.float(*(float32*)value);
    } else if (t.kind == TypeKind::FLOAT64) {
        this.float(*(float64*)value);
    } else if (t.kind == TypeKind::ANY) {
        this.add("(any) ");
        any value2 = *(any*)value;
        this.value((Type*)value2.typeid, value2.value);
    } else if (t.kind == TypeKind::INTRINSIC) {
        this.intrinsic(t.get_extra_data().name);
    } else if (t.kind == TypeKind::POINTER) {
        // format using the type:
        // this.add("(");
        // this.type_(t);
        // this.add(") 0x");
        // format using &:
        this.add("&0x");
        usize ptr = *(usize*)value;
        if (ptr == 0) {
            this.add("0");
        } else {
            while (value > 0) {
                this.push(HEX_DIGITS[value & 0xf]);
                value >>= 4;
            }
        }
    } else if (t.kind == TypeKind::ARRAY) {
        Type* of = t.get_extra_data().array.of;
        none[] array = *(none[]*)value;
        if (of.kind == TypeKind::UINT8 && t.is_named() && t.get_name().try().eq("string")) {
            this.add("\"");
            for (mut usize i = 0; i < array.len; i += 1) {
                this.char_((char)array[i]);
            }
            this.add("\"");
        } else {
            this.add("[");
            for (mut usize i = 0; i < array.len; i += 1) {
                none* elt = array.ptr + of.sizeof();
                this.value(of, value);
                if (i != array.len - 1) {
                    this.add(", ");
                }
            }
            this.add("]");
        }
    } else if (t.kind == TypeKind::FUNCTION) {
        // todo
        this.add("<function pointer>");
    } else if (t.kind == TypeKind::STRUCT) {
        StructTypeData* extra = &t.get_extra_data().struct_;
        this.add("struct ");
        this.try_name(t, true);
        this.add("{");
        this.indent += 1;
        for (mut usize i = 0; i < extra.members.len; i += 1) {
            StructMemberTypeData* member = &extra.members[i];
            this.newline();
            this.add(member.name);
            this.add(" = ");
            this.value(member.type_, value + member.offset);
            this.add(";");
        }
        this.indent -= 1;
        this.newline();
        this.add("}");
    } else if (this.kind == TypeKind::UNION) {
        StructTypeData* extra = &t.get_extra_data().union_;
        this.add("union ");
        this.try_name(t, true);
        this.add("{");
        this.indent += 1;
        for (mut usize i = 0; i < extra.members.len; i += 1) {
            UnionMemberTypeData* member = &extra.members[i];
            this.newline();
            this.add(member.name);
            this.add(" = ");
            this.value(member.type_, value + member.offset);
            this.add(";");
        }
        this.indent -= 1;
        this.newline();
        this.add("}");
    } else if (this.kind == TypeKind::ENUM) {
        StructTypeData* extra = &t.get_extra_data().enum_;
        this.add("(enum");
        this.try_name(t, false);
        // todo: add backing type and fix call to compare and finish it up
        this.add(")");
        for (mut usize i = 0; i < extra.members.len; i += 1) {
            EnumMemberTypeData* member = &extra.members[i];
            if (mem::compare(member.value, value)) {

            }
        }
    } else if (this.kind == TypeKind::SUM) {
        // todo
    } else {
        fatal_error("Fatal error: Invalid typeid kind");
    }
}

fn (none | Error::NOT_ENOUGH_FORMAT_ARGS | Error::INVALID_FORMAT_FIELD) Formatter.field(mut Formatter* this, string field, any[] data, usize* data_pos) {
    if (field.len > 0) {
        return Error::INVALID_FORMAT_FIELD;
    }
    if (*data_pos > data.length) {
        return Error::NOT_ENOUGH_FORMAT_ARGS;
    }
    any value = this.data[*data_pos];
    *data_pos += 1;
    this.value(out, (Type*)data_value.typeid, value.value);
}

@export
fn (String | Error::NOT_ENOUGH_FORMAT_ARGS | Error::INVALID_FORMAT_FIELD | Error::FORMAT_FIELD_NOT_CLOSED | Error::FORMAT_FIELD_NOT_OPENED) Formatter.main(string str) {
    String current_field;
    current_field.init(this.allocator, 0);
    usize data_pos = 0;
    for (mut usize i = 0; i < str.len; i += 1) {
        char c = str[i];
        if (c == '{' && !(i != str.len - 1 && str[i + 1] == '{')) {
            if (i == str.len - 1) {
                return Error::INVALID_FORMAT_FIELD;
            } else if (str[i + 1] == '{') {
                out.add("{");
                continue;
            }
            current_field.reset(0).try();
            i += 1;
            while (i < str.len) {
                c = str[i];
                if (c == '}') {
                    break;
                }
                current_field.push(c);
                i += 1;
            }
            this.field(out, current_field.to_array(), data, &data_pos);
        } else if (c == '}' && !(i != str.len - 1 && str[i + 1] == '}')) {
            return Error::FORMAT_FIELD_NOT_OPENED;
        } else {
            out.push(c);
        }
    }
    return out;
}

@export
fn (String | Error::NOT_ENOUGH_FORMAT_ARGS | Error::INVALID_FORMAT_FIELD | Error::FORMAT_FIELD_NOT_CLOSED | Error::FORMAT_FIELD_NOT_OPENED) format(Allocator* allocator, string str, any[] data) {
    Formatter f;
    f.config = {};
    f.data = data;
    f.indent = 0;
    f.init(allocator, 0);
    f.main(str);
    String out;
    out.init(f.len, 0);
    f.copy_to(out);
    f.destroy();
    return out;
}