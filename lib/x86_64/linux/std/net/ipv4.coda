module std::net;

@export
type IPv4Address = struct {
    uint8[4] octets;
};

@export
fn IPv4Address ipv4(uint8 a, uint8 b, uint8 c, uint8 d, uint16 port) {
    return {
        .octets = { a, b, c, d },
        .port = port,
    };
}

@export
fn IPv4Address ipv4_any(uint16 port) {
    return ipv4(0, 0, 0, 0, port);
}

@export
fn IPv4Address ipv4_loopback(uint16 port) {
    return ipv4(127, 0, 0, 1, port);
}
