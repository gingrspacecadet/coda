module std::error;

include std;

@export
type Error = enum {
    ALLOCATION_FAILED,
    OUT_OF_BOUNDS,
    INVALID_ENCODED_DATA,
    IS_EMPTY,
};

@export
string[] ERROR_MEANINGS = {
    .[Error::ALLOCATION_FAILED] = "Allocation failed",
    .[Error::OUT_OF_BOUNDS] = "Out of bounds",
    .[Error::INVALID_ENCODED_DATA] = "Invalid encoding",
    .[Error::IS_EMPTY] = "Is empty",
};

@export
@noreturn
fn fatal_error(string message) {

}

@export
@noreturn
fn Error.throw(Error this) {
    // tbd
    std::print("Error: {}", [ERROR_MEANINGS[this]]);
    std::process::exit(std::process::EXIT_FALIURE);
}

@export
@inline
fn T try<T>(value: (T | Error)) {
    match (value) {
        Error {
            value.throw();
        }
        T {
            return value;
        }
    }
}