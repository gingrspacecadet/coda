module std::fs;

include std::types : _;
include std::system : sys;

@export
type File = struct {
    int fd; // TODO: this is temporary, needs to be per-OS abstraction
};

@export
type FileError = enum {
    Some,
};

@export
fn (File | FileError) File.create(string path) {
    int fd = sys::syscall(sys::SysNums::Open, (uint64)path.ptr, 1 | 64, 420);
    if (fd < 0) return FileError::Some;
    
    return (File){fd};
}

@export
fn (File | FileError) File.open(string path) {
    int fd = sys::syscall(sys::SysNums::Open, (uint64)path.ptr);
    if (fd < 0) return FileError::Some;

    return (File){fd};
}

@export
fn int File.write(File this, uint8[] buf) {
    return sys::syscall(sys::SysNums::Write, (uint64)this.fd, (uint64)buf.ptr, buf.len);
}

@export
fn (usize | FileError) File.read(File this, uint8[] buf) {
    int ans = sys::syscall(sys::SysNums::Read, (uint64)this.fd, (uint64)buf.ptr, buf.len);
    if (ans < 0) return FileError::Some;
    return (usize)ans;
}

@export
fn usize File.size(File this) {
    uint64 current = (uint64)sys::syscall(sys::SysNums::Lseek, (uint64)this.fd, 0, 1);
    uint64 size = (uint64)sys::syscall(sys::SysNums::Lseek, (uint64)this.fd, 0, 2);
    sys::syscall(sys::SysNums::Lseek, (uint64)this.fd, current);

    return size;
}