module std::fs;

include std::prelude : _;
include std::system : sys;

@export
type File = struct {
    int fd; // TODO: this is temporary, needs to be per-OS abstraction
};

@export
fn File File.create(string path) {
    return {
        .fd = sys::syscall(sys::SysNums::Open, (uint64)path.ptr, 1 | 64, 420) // O_CREAT | O_WRONLY | O_TRUNC, 0644
    };
}

@export
fn File File.open(string path) {
    return {
        .fd = sys::syscall(sys::SysNums::Open, (uint64)path.ptr),
    };
}

@export
fn int File.write(File this, uint8[] buf) {
    return sys::syscall(sys::SysNums::Write, (uint64)this.fd, (uint64)buf.ptr, buf.len);
}

@export
fn int File.read(File this, uint8[] buf) {
    return sys::syscall(sys::SysNums::Read, (uint64)this.fd, (uint64)buf.ptr, buf.len);
}