module std::fs;

include std::io;

struct File;

fn uint64 File.read(mut File self, mut byte[] dst);
fn uint64 File.write(mut File self, byte[] src);
fn uint64 File.seek(mut File self, std::io::SeekOrigin origin, int64 offset);
fn uint64 File.tell(File self);
fn none File.close(mut File self);

fn File | IOError open(string path);

fn File | IOError create(string path);

fn bool exists(string path);

fn none | IOError remove(string path);

fn none | IOError rename(string from, string to);

fn none | IOError mkdir(string path);

fn none | IOError mkdirs(string path);
