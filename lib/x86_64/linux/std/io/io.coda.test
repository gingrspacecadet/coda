module std::io;

enum IOError;

interface Reader {
    fn uint64 | IOError read(mut self, mut byte[] dst);
}

interface Writer {
    fn uint64 | IOError write(mut self, byte[] src);
}

interface Seeker {
    fn uint64 seek(mut self, SeekOrigin origin, int64 offset);
    fn uint64 tell(self);
}

interface Flushable {
    fn none flush(mut self);
}

enum SeekOrigin {
    Begin,
    Current,
    End
}

fn uint64 | IOError copy(mut Reader src, mut Writer dst);

fn uint64 | IOError copy_n(mut Reader src, mut Writer dst, uint64 count);

fn none | IOError write_all(mut Writer dst, byte[] bytes);

fn none read_exact(mut Reader src, mut byte[] bytes);

fn none flush(mut Writer dst);