module std::sort;

fn int partition<T>(mut Iterable<T> *arr, int low, int high) {
    T pivot = arr.at(high);
    int i = low - 1;

    for (int j = low; j < high; j += 1) {
        if (arr.at(j).le(pivot)) {
            i += 1;
            arr.at(i).swap(arr.at(j));
        }
    }
    arr.at(i + 1).swap(arr.at(high));
    return i + 1;
}

@export
fn none quick_sort<T>(mut Iterable<T> *arr, int low, int high) {
    if (low < high) {
        int pivot_index = partition(arr, low, high);

        quick_sort(arr, low, pivot_index - 1);
        quick_sort(arr, pivot_index + 1, high);
    }
}

fn none mut Iterable<T>.quick_sort(mut Iterable<T> *arr) {
    quick_sort(arr, 0, arr.length() - 1);
}