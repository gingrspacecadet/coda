module std::sort;

include std::collections : _;
include std::constraints : _;

@export
fn none selection_sort<T: Swappable; Comparable>(mut Sequence<T> *seq) {
    for (usize i = 0; i < seq.len(); i += 1) {
        usize min_index = i;
        for (usize j = i + 1; j < seq.len(); j += 1) {
            if (seq.at(j).lt(seq.at(min_index))) {
                min_index = j;
            }
        }
        if (min_index != i) {
            seq.at(i).swap(seq.at(min_index));
        }
    }
}

@export
fn none mut Sequence<T>.selection_sort<T: Swappable; Comparable>(Sequence<T> *this) {
    selection_sort(this);
}