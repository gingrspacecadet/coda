module std::sort;

@export
fn none bubble_sort<T: Comparable>(mut Iterable<T> *arr) {
    int i; int j;
    bool swapped;

    for (i = 0; i < arr.len() - 1; i += 1) {
        swapped = false;

        for (j = 0; j < arr.len() - i - 1; j += 1) {
            if (arr.at(j).gt(arr.at(j + 1))) {
                arr.at(j).swap(arr.at(j + 1));
                swapped = true;
            }
        }

        if (!swapped) {
            break;
        }
    }
}