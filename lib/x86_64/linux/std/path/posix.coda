module std::path::posix;

include std::
include std::collections : _;

@export
string sep = "/";
@export
string delimiter = ":";

fn none normalise<T: Contiguous<char>>(mut String* out, T* path) {
    List<string> data;
    path.split(data, sep);
    List<string*> parts;
    parts.init(out->allocator, 0);
    for (mut usize i = 0; i < data.len; i++) {
        string part = data->ptr[i];
        if (part.eq("") && i > 0) {
            continue;
        } else if (part.eq(".") && i > 0) {
            continue;
        } else if (part.eq("..") && i > 0) {
            parts.pop();
        } else {
            parts.push(part);
        }
    }
    out.clear();
    parts.join_ptr(out, sep);
}