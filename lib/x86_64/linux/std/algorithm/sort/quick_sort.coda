module std::algorithm;

include std::collections : _;
include std::constraints : _;
include std::mem;

fn int partition<T: Comparable>(mut Sequence<T> *seq, int low, int high) {
    T pivot = seq.at(high);
    int i = low - 1;

    for (int j = low; j < high; j += 1) {
        if (seq.at(j).le(&pivot)) {
            i += 1;
            seq.at(i).swap(seq.at(j));
        }
    }
    seq.at(i + 1).swap(seq.at(high));
    return i + 1;
}

@export
fn none quick_sort<T: Comparable>(mut Sequence<T> *seq, int low, int high) {
    if (low < high) {
        int pivot_index = partition(seq, low, high);

        quick_sort(seq, low, pivot_index - 1);
        quick_sort(seq, pivot_index + 1, high);
    }
}

@export,inline
fn none mut Sequence<T>.quick_sort<T: Comparable>(mut Sequence<T> *seq) {
    quick_sort(seq, 0, seq.length() - 1);
}