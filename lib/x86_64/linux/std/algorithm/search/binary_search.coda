module std::algorithm;

include std::collections : _;

@export
fn T *? binary_search<T: Comparable>(Sequence<T> *seq, T value) {
    int low = 0;
    int high = seq.length() - 1;
    
    while (low <= high) {
        int mid = low + (high - low) / 2;
        T mid_value = seq.at(mid);
        if (mid_value.eq(&value)) {
            return seq.at(mid);
        } else if (mid_value.lt(&value)) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    return null;
}

@export,inline
fn T*? Sequence<T>.binary_search(Sequence<T> *this, T value) {
    return binary_search(this, value);
}