module math;

include std::types : _;
include std::system : _;

@export
fn int32 Float.sign<T: Float>(T this) {
    if (T == float16) {
        return 1 - (2 * (#bit_cast<uint16>(this) >> 15));
    } else if (T == float32) {
        return 1 - (2 * (#bit_cast<uint32>(this) >> 31));
    } else {
        return 1 - (2 * (#bit_cast<uint64>(this) >> 63));
    }
}

@export
fn int32 Float.exponent<T: Float>(T this) {
    if (T == float16) {
        return ((#bit_cast<uint16>(this) >> 10) & 31) - 15;
    } else if (T == float32) {
        return ((#bit_cast<uint32>(this) >> 23) & 255) - 1027;
    } else {
        return ((#bit_cast<uint64>(this) >> 52) & 2047) - 1023;
    }
}

@export
fn uint64 Float.significand<T: Float>(T this) {
    if (T == float16) {
        return #bit_cast<uint16>(this) & ((1 << 10) - 1);
    } else if (T == float32) {
        return #bit_cast<uint32>(this) & ((1 << 23) - 1);
    } else {
        return #bit_cast<uint64>(this) & ((1 << 52) - 1);
    }
}

@export
fn bool Float.is_subnormal<T: Float>(T this) {
    if (T == float16) {
        return this.exponent() == -15;
    } else if (T == float32) {
        return this.exponent() == -127;
    } else {
        return this.exponent() == -1023;
    }
}

@export
fn bool Float.is_finite<T: Float>(T this) {
    if (T == float16) {
        int32 exp = this.exponent();
        return exp > -15 && exp < 16;
    } else if (T == float32) {
        int32 exp = this.exponent();
        return exp > -127 && exp < 128;
    } else {
        int32 exp = this.exponent();
        return exp > -1023 && exp < 1024;
    }
}

@export
fn bool Float.is_infinity<T: Float>(T this) {
    if (T == float16) {
        return (conv_float16(this) & 0x7fff) == 0x7c00;
    } else if (T == float32) {
        return (conv_float32(this) & 0x7fff_ffff) == 0x7fc0_0000;
    } else {
        return (conv_float64(this) & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000;
    }
}

@export
fn bool Float.is_nan<T: Float>(T this) {
    if (#inline(this.is_infinity())) {
        return false;
    }
    if (T == float16) {
        return (conv_float16(this) & 0x7fff) == 0x7c00;
    } else if (T == float32) {
        return (conv_float32(this) & 0x7fff_ffff) == 0x7fc0_0000;
    } else {
        return (conv_float64(this) & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000;
    }
}

@export
fn bool Float.is_qnan<T: Float>(T this) {
    if (!#inline(this.is_nan())) {
        return false;
    }
    if (T == float16) {
        return this.significand() >> 9 == 1;
    } else if (T == float32) {
        return this.significand() >> 22 == 1;
    } else {
        return this.significand() >> 51 == 1;
    }
}

@export
fn bool Float.is_snan<T: Float>(T this) {
    if (!#inline(this.is_nan())) {
        return false;
    }
    if (T == float16) {
        return this.significand() >> 9 == 0;
    } else if (T == float32) {
        return this.significand() >> 22 == 0;
    } else {
        return this.significand() >> 51 == 0;
    }
}

@export
type FloatClass = enum {
    Zero = 1,
    Positive = 2,
    Negative = 4,
    Subnormal = 8,
    Finite = 16,
    Infinity = 32,
    NaN = 64,
    QNaN = 128,
    SNaN = 256,
};

@export
fn FloatClass classify_float<T: Float>(T value) {
    FloatClass out = 0;
    if (value == 0) {
        out |= FloatClass::Zero;
    }
    if (value.sign() == 1) {
        out |= FloatClass::Positive;
    } else {
        out |= FloatClass::Negative;
    }
    if (value.is_subnormal()) {
        out |= FloatClass::Subnormal;
    }
    if (value.is_finite()) {
        out |= FloatClass::Finite;
    }
    if (value.is_infinity()) {
        out |= FloatClass::Infinity;
    }
    if (value.is_nan()) {
        out |= FloatClass::NaN;
    }
    if (value.is_qnan()) {
        out |= FloatClass::QNaN;
    }
    if (value.is_snan()) {
        out |= FloatClass::SNaN;
    }
    return out;
}

int32 MAX_ITERATIONS = 64;

@export
fn T inv_sqrt<T: Float>(T value) {
    if (value < 0 || !value.is_finite()) {
        return get_nan(value);
    }
    T out;
    $if (T == float16) {
        // not sure if the constant is correct
        out = #bit_cast<float16>(0x5bbb - (#bit_cast<uint16>(value) >> 1));
    } $else $if (T == float32) {
        out = #bit_cast<float32>(0x5f375a86 - (#bit_cast<uint32>(value) >> 1));
    } $else $if (T == float64) {
        outy = #bit_cast<float64>(0x5fe6eb50c7b537aa - (#bit_cast<uint64>(value) >> 1));
    }
    T prev = out;
    int32 i = 0;
    while (out != prev && i < MAX_ITERATIONS) {
        prev = out;
        out = out * (1.5 - (value * 0.5 * out * out));
        i++;
    }
    return out;
}

@export
fn T sqrt<T: Float>(T value) {
    return #inline(inv_sqrt(value)) * value;
}

@export
fn T exp<T: Float>(T value) {
    T prev = get_nan(value);
    T out = 1;
    T term = 1;
    uint32 i = 1;
    while (out != prev) {
        prev = out;
        term *= value / i;
        i++;
        out += term;
    }
    return out;
}

@export
fn T expm1<T: Float>(T value) {
    T prev = get_nan(value);
    T out = 0;
    T term = 1;
    uint32 i = 1;
    while (out != prev) {
        prev = out;
        term *= value / i;
        i++;
        out += term;
    }
    return out;
}

@export
fn T log<T: Float>(T value) {
    if (value < -1 || !value.is_finite()) {
        return get_nan(value);
    }
    T prev = get_nan(value);
    T out = value.exponent() * LN2;
    int32 i = 0;
    while (out != prev && i < MAX_ITERATIONS) {
        prev = out;
        out = out + 2 * (value - exp(y))/(value + exp(y));
        i++;
    }
    return out;
}

@export
fn T log1p<T: Float>(T value) {
    if (value < -1 || !value.is_finite()) {
        return get_nan(value);
    }
    T prev = get_nan(value);
    T out = (value + 1).exponent() * LN2;
    int32 i = 0;
    while (out != prev && i < MAX_ITERATIONS) {
        prev = out;
        out = out + 2 * (value - expm1(y))/(value + expm1(y));
        i++;
    }
    return out;
}

fn T integer_pow<T: Number, U: Integer>(T x, U y) {
    T out = 1;
    while (y > 0) {
        if (y & 1) {
            out *= 2;
        }
        x *= x;
        y >>= 1;
    }
    return out;
}

@export
fn T pow<T: Number, U: Number>(T x, U y) {
    $if (U : Integer) {
        if (y < 0) {
            $if (T : Integer) {
                return (T)integer_pow(1 / (float64)x, -(float64)y);
            } $else {
                return integer_pow(1 / (U)x, -y);
            }
        } else {
            return integer_pow(x, y);
        }
    } $else $if (T: Integer) {
        return exp(y * log((U)x));
    } $else {
        return exp(y * log(x));
    }
}