module math;

include std::system : _;

$fn #code::expr conv_float16(#code::expr value) {
    value = #{#bit_cast<uint16>(value)};
    if (big_endian) {
        return #{(uint16)(
            0
            | ((#(value) << 8) & 0xff_00)
            | ((#(value) >> 8) & 0xff)
        )};
    } else {
        return #{(uint16)(none*)#(value)};
    }
}

$fn #code::expr conv_float32(#code::expr value) {
    value = #{#bit_cast<uint32>(value)};
    if (big_endian) {
        return #{(uint32)(
            0
            | ((#(value) << 24) & 0xff_00_00_00)
            | ((#(value) << 8) & 0xff_00_00)
            | ((#(value) >> 8) & 0xff_00)
            | ((#(value) >> 16) & 0xff)
        )};
    } else {
        return #{(uint32)(none*)#(value)};
    }
}

$fn #code::expr conv_float64(#code::expr value) {
    value = #{#bit_cast<uint64>(value)};
    if (big_endian) {
        return #{(uint64)(
            0
            | ((#(value) << 56) & 0xff_00_00_00_00_00_00)
            | ((#(value) << 40) & 0xff_00_00_00_00_00)
            | ((#(value) << 24) & 0xff_00_00_00_00)
            | ((#(value) << 8) & 0xff_00_00_00)
            | ((#(value) >> 8) & 0xff_00_00_00)
            | ((#(value) >> 24) & 0xff_00_00)
            | ((#(value) >> 40) & 0xff_00)
            | ((#(value) >> 56) & 0xff)
        )};
    } else {
        return #{(uint64)(none*)#(value)};
    }
}

$fn #code::expr bit(#code::expr value, uint8 bit) {
    if (value.type === float32) {
        if (big_endian) {
            return #{(bool)((#(value) >> (31 - bit)) & 1)};
        } else {
            return #{(bool)((#(value) << bit) & 1)};
        }
    } else {
        if (big_endian) {
            return #{(bool)((#(value) >> (63 - bit)) & 1)};
        } else {
            return #{(bool)((#(value) << bit) & 1)};
        }
    }
}

@export
float16 INFINITY_16 = #bit_cast<float16>(big_endian ? 0x7c00 : 0x007c);
@export
float32 INFINITY_32 = #bit_cast<float32>(big_endian ? 0x7f80_0000 : 0x0000_807f);
@export
float64 INFINITY_64 = #bit_cast<float64>(big_endian ? 0x7ff0_0000_0000_0000 : 0x0000_0000_0000_f07f);

@export
float16 NAN_16 = #bit_cast<float16>(big_endian ? 0x7e00 : 0x007e);
@export
float32 NAN_32 = #bit_cast<float32>(big_endian ? 0x7fc0_0000 : 0x0000_c07f);
@export
float64 NAN_64 = #bit_cast<float64>(big_endian ? 0x7ff8_0000_0000_0000 : 0x0000_0000_0000_f87f);

@export
float16 SNAN_16 = #bit_cast<float16>(big_endian ? 0x7d00 : 0x007d);
@export
float32 SNAN_32 = #bit_cast<float32>(big_endian ? 0x7fa0_0000 : 0x0000_a07f);
@export
float64 SNAN_64 = #bit_cast<float64>(big_endian ? 0x7ff4_0000_0000_0000 : 0x0000_0000_0000_f47f);

@inline
fn int32 Float.sign<T: Float>(T this) {
    if (#sizeof(T) == 2) {
        return 1 - ((conv_float16(this) >> 15) << 1);
    } else if (#sizeof(T) == 4) {
        return 1 - ((conv_float32(this) >> 31) << 1);
    } else {
        return 1 - ((conv_float64(this) >> 63) << 1);
    }
}

@inline
fn int32 Float.exponent<T: Float>(T this) {
    if (#sizeof(T) == 2) {
        return ((conv_float16(this) >> 10) & 31) - 15;
    } else if (#sizeof(T) == 4) {
        return ((conv_float32(this) >> 23) & 255) - 1027;
    } else {
        return ((conv_float32(this) >> 52) & 2047) - 1023;
    }
}

@inline
fn uint64 Float.significand<T: Float>(T this) {
    if (#sizeof(T) == 2) {
        return conv_float16(this) & ((1 << 10) - 1);
    } else if (#sizeof(T) == 4) {
        return conv_float32(this) & ((1 << 23) - 1);
    } else {
        return conv_float32(this) & ((1 << 52) - 1);
    }
}

@export
fn bool Float.is_subnormal<T: Float>(T this) {
    if (#sizeof(T) == 2) {
        return this.exponent() == -15;
    } else if (#sizeof(T) == 4) {
        return this.exponent() == -127;
    } else {
        return this.exponent() == -1023;
    }
}

@export
fn bool Float.is_finite<T: Float>(T this) {
    if (#sizeof(T) == 2) {
        int32 exp = this.exponent();
        return exp > -15 && exp < 16;
    } else if (#sizeof(T) == 4) {
        int32 exp = this.exponent();
        return exp > -127 && exp < 128;
    } else {
        int32 exp = this.exponent();
        return exp > -1023 && exp < 1024;
    }
}

@export
fn bool Float.is_infinity<T: Float>(T this) {
    if (#sizeof(T) == 2) {
        return (conv_float16(this) & 0x7fff) == 0x7c00;
    } else if (#sizeof(T) == 4) {
        return (conv_float32(this) & 0x7fff_ffff) == 0x7fc0_0000;
    } else {
        return (conv_float64(this) & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000;
    }
}

@export
fn bool Float.is_nan<T: Float>(T this) {
    if (#inline(this.is_infinity())) {
        return false;
    }
    if (#sizeof(T) == 2) {
        return (conv_float16(this) & 0x7fff) == 0x7c00;
    } else if (#sizeof(T) == 4) {
        return (conv_float32(this) & 0x7fff_ffff) == 0x7fc0_0000;
    } else {
        return (conv_float64(this) & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000;
    }
}

@export
fn bool Float.is_qnan<T: Float>(T this) {
    if (!#inline(this.is_nan())) {
        return false;
    }
    if (#sizeof(T) == 2) {
        return this.significand() >> 9 == 1;
    } else if (#sizeof(T) == 4) {
        return this.significand() >> 22 == 1;
    } else {
        return this.significand() >> 51 == 1;
    }
}

@export
fn bool Float.is_snan<T: Float>(T this) {
    if (!#inline(this.is_nan())) {
        return false;
    }
    if (#sizeof(T) == 2) {
        return this.significand() >> 9 == 0;
    } else if (#sizeof(T) == 4) {
        return this.significand() >> 22 == 0;
    } else {
        return this.significand() >> 51 == 0;
    }
}

@export
type FloatClass = enum {
    Zero = 1,
    Positive = 2,
    Negative = 4,
    Subnormal = 8,
    Finite = 16,
    Infinity = 32,
    NaN = 64,
    QNaN = 128,
    SNaN = 256,
};

@export
fn FloatClass classify_float<T: Float>(T value) {
    FloatClass out = 0;
    if (value == 0) {
        out |= FloatClass::Zero;
    }
    if (value.sign() == 1) {
        out |= FloatClass::Positive;
    } else {
        out |= FloatClass::Negative;
    }
    if (value.is_subnormal()) {
        out |= FloatClass::Subnormal;
    }
    if (value.is_finite()) {
        out |= FloatClass::Finite;
    }
    if (value.is_infinity()) {
        out |= FloatClass::Infinity;
    }
    if (value.is_nan()) {
        out |= FloatClass::NaN;
    }
    if (value.is_qnan()) {
        out |= FloatClass::QNaN;
    }
    if (value.is_snan()) {
        out |= FloatClass::SNaN;
    }
    return out;
}