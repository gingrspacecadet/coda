module math;

include std::system : _;

@export
float16 INFINITY_16 = #bit_cast<float16>(big_endian ? 0x7c00 : 0x007c);
@export
float32 INFINITY_32 = #bit_cast<float32>(big_endian ? 0x7f80_0000 : 0x0000_807f);
@export
float64 INFINITY_64 = #bit_cast<float64>(big_endian ? 0x7ff0_0000_0000_0000 : 0x0000_0000_0000_f07f);

@export
float16 NAN_16 = #bit_cast<float16>(big_endian ? 0x7e00 : 0x007e);
@export
float32 NAN_32 = #bit_cast<float32>(big_endian ? 0x7fc0_0000 : 0x0000_c07f);
@export
float64 NAN_64 = #bit_cast<float64>(big_endian ? 0x7ff8_0000_0000_0000 : 0x0000_0000_0000_f87f);

@export
float16 SNAN_16 = #bit_cast<float16>(big_endian ? 0x7d00 : 0x007d);
@export
float32 SNAN_32 = #bit_cast<float32>(big_endian ? 0x7fa0_0000 : 0x0000_a07f);
@export
float64 SNAN_64 = #bit_cast<float64>(big_endian ? 0x7ff4_0000_0000_0000 : 0x0000_0000_0000_f47f);

@export
fn T Float.to_infinity<T: Float>(T this) {
    if (T == float16) {
        return INFINITY_16;
    } else if (T == float32) {
        return INFINITY_32;
    } else {
        return INFINITY_64;
    }
}

@export
fn T to_nan<T: Float>(T this) {
    if (T == float16) {
        return NAN_16;
    } else if (T == float32) {
        return NAN_32;
    } else {
        return NAN_64;
    }
}

@export
fn T to_snan<T: Float>(T this) {
    if (T == float16) {
        return SNAN_16;
    } else if (T == float32) {
        return SNAN_32;
    } else {
        return SNAN_64;
    }
}

@export
fn int32 Float.sign<T: Float>(T this) {
    if (T == float16) {
        return 1 - (2 * (#bit_cast<uint16>(this) >> 15));
    } else if (T == float32) {
        return 1 - (2 * (#bit_cast<uint32>(this) >> 31));
    } else {
        return 1 - (2 * (#bit_cast<uint64>(this) >> 63));
    }
}

@export
fn int32 Float.exponent<T: Float>(T this) {
    if (T == float16) {
        return ((#bit_cast<uint16>(this) >> 10) & 31) - 15;
    } else if (T == float32) {
        return ((#bit_cast<uint32>(this) >> 23) & 255) - 1027;
    } else {
        return ((#bit_cast<uint64>(this) >> 52) & 2047) - 1023;
    }
}

@export
fn uint64 Float.significand<T: Float>(T this) {
    if (T == float16) {
        return #bit_cast<uint16>(this) & ((1 << 10) - 1);
    } else if (T == float32) {
        return #bit_cast<uint32>(this) & ((1 << 23) - 1);
    } else {
        return #bit_cast<uint64>(this) & ((1 << 52) - 1);
    }
}

@export
fn bool Float.is_subnormal<T: Float>(T this) {
    if (T == float16) {
        return this.exponent() == -15;
    } else if (T == float32) {
        return this.exponent() == -127;
    } else {
        return this.exponent() == -1023;
    }
}

@export
fn bool Float.is_finite<T: Float>(T this) {
    if (T == float16) {
        int32 exp = this.exponent();
        return exp > -15 && exp < 16;
    } else if (T == float32) {
        int32 exp = this.exponent();
        return exp > -127 && exp < 128;
    } else {
        int32 exp = this.exponent();
        return exp > -1023 && exp < 1024;
    }
}

@export
fn bool Float.is_infinity<T: Float>(T this) {
    if (T == float16) {
        return (conv_float16(this) & 0x7fff) == 0x7c00;
    } else if (T == float32) {
        return (conv_float32(this) & 0x7fff_ffff) == 0x7fc0_0000;
    } else {
        return (conv_float64(this) & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000;
    }
}

@export
fn bool Float.is_nan<T: Float>(T this) {
    if (#inline(this.is_infinity())) {
        return false;
    }
    if (T == float16) {
        return (conv_float16(this) & 0x7fff) == 0x7c00;
    } else if (T == float32) {
        return (conv_float32(this) & 0x7fff_ffff) == 0x7fc0_0000;
    } else {
        return (conv_float64(this) & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000;
    }
}

@export
fn bool Float.is_qnan<T: Float>(T this) {
    if (!#inline(this.is_nan())) {
        return false;
    }
    if (T == float16) {
        return this.significand() >> 9 == 1;
    } else if (T == float32) {
        return this.significand() >> 22 == 1;
    } else {
        return this.significand() >> 51 == 1;
    }
}

@export
fn bool Float.is_snan<T: Float>(T this) {
    if (!#inline(this.is_nan())) {
        return false;
    }
    if (T == float16) {
        return this.significand() >> 9 == 0;
    } else if (T == float32) {
        return this.significand() >> 22 == 0;
    } else {
        return this.significand() >> 51 == 0;
    }
}

@export
type FloatClass = enum {
    Zero = 1,
    Positive = 2,
    Negative = 4,
    Subnormal = 8,
    Finite = 16,
    Infinity = 32,
    NaN = 64,
    QNaN = 128,
    SNaN = 256,
};

@export
fn FloatClass classify_float<T: Float>(T value) {
    FloatClass out = 0;
    if (value == 0) {
        out |= FloatClass::Zero;
    }
    if (value.sign() == 1) {
        out |= FloatClass::Positive;
    } else {
        out |= FloatClass::Negative;
    }
    if (value.is_subnormal()) {
        out |= FloatClass::Subnormal;
    }
    if (value.is_finite()) {
        out |= FloatClass::Finite;
    }
    if (value.is_infinity()) {
        out |= FloatClass::Infinity;
    }
    if (value.is_nan()) {
        out |= FloatClass::NaN;
    }
    if (value.is_qnan()) {
        out |= FloatClass::QNaN;
    }
    if (value.is_snan()) {
        out |= FloatClass::SNaN;
    }
    return out;
}

@export
fn T inv_sqrt<T: Float>(T value) {
    if (value < 0 || !value.is_finite()) {
        return to_nan(value);
    }
    T out;
    if (T == float16) {
        // not sure if the constant is correct
        out = #bit_cast<float16>(0x5bbb - (#bit_cast<uint16>(value) >> 1));
    } else if (T == float32) {
        out = #bit_cast<float32>(0x5f375a86 - (#bit_cast<uint32>(value) >> 1));
    } else if (T == float64) {
        out = #bit_cast<float64>(0x5fe6eb50c7b537aa - (#bit_cast<uint64>(value) >> 1));
    }
    float32 prev = out;
    while (out != prev) {
        prev = out;
        out = out * (1.5 - (value * 0.5 * out * out));
    }
    return out;
}

@export
fn T sqrt<T: Float>(T value) {
    return #inline(inv_sqrt(value)) * value;
}
