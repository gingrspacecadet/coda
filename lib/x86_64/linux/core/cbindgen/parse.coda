type Parser = struct {
    mut Lexer *lexer;
};

type Function = struct {
    string name;
    DynArray<Param> params;
    Type return_type;
};

type Param = struct {
    string name;
    Type type;
};

type Type = struct {
    string name;
    bool is_const;
    (
        struct {Type pointee} |
        BuiltinType
    ) as;
};

type BuiltinType = enum {
    Void,
    Int,
    Float,
    Double,
    Char,
    Bool,
};

fn Function Parser.parse_function(mut Parser *this) {
    Function f;

    f.return_type = this.parse_type(),
    f.name = this.lexer.next_token().value,
    this.lexer.expect_token(TokenType::LeftParen),
    f.params = this.parse_params(),
    this.lexer.expect_token(TokenType::RightParen),

    return f;
}

fn DynArray<Param> Parser.parse_params(mut Parser *this) {
    DynArray<Param> params = .create();

    while (this.lexer.peek_token().kind != TokenType::RightParen) {
        Param p;
        p.kind = this.parse_type(),
        p.name = this.lexer.next_token().value,
        params.push(p),

        if (this.lexer.peek_token().kind == TokenType::Comma) {
            this.lexer.next_token(); // consume comma
        }
    }

    return params;
}

$fn #code::stmt<match> gen_builtin_type_match() {
    #code::stmt<match> out;

    for (usize i = 0; i < #typeinfo(BuiltinType).variant_count; i++) {
        BuiltinType variant = #typeinfo(BuiltinType).variant(i);
        string variant_name = #typeinfo(BuiltinType).variant_name(i);

        out += #{
            BuiltinType::#(variant) v: {
                t.name = #(variant_name),
                t.as = v;
            }
        };
    }

    return out;
}

fn Type Parser.parse_type(mut Parser *this) {
    Type t;
    t.is_const = false;

    if (this.lexer.peek_token().kind == Tokens::CONST) {
        this.lexer.next_token(); // consume 'const'
        t.is_const = true;
    }



    return t;
}