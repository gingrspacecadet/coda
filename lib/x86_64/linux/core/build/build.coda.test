module core::build;

include std::process;

type Library = struct {
    string name;
    string[] sources;
    string[] include_dirs;
    string[] defines;
    string[] links;
};

type Executable = struct {
    string name;
    string[] sources;
    Target *[] deps;
};

type Target = Library | Executable;

Target[] load(string path);

type Command = std::process::Command;

fn none Command.clear();

