module core::build::c;

include core::build : build;
include std::string : string;

@export
constraint Toolchain {
    fn none plan_library(Toolchain *self, build::Build *build, Library *library);
    fn none plan_executable(Toolchain *self, build::Build *build, Executable *executable);
}

@export
type Profile = struct {
    string name;
    Toolchain toolchain;
};

@export
fn Profile *profile(build::Project *project, string name) {
    Profile *profile = project.arena.alloc<Profile>();

    *profile = {
        .name = name,
        .toolchain = none,
    };

    project.add_profile(profile);
    return profile;
}

@export
fn Profile *Profile.toolchain(Profile *self, Toolchain toolchain) {
    self.toolchain = toolchain;
    return self;
}

@export
type GCC: Toolchain = struct {
};

@export
type Clang: Toolchain = struct {
};

@export
fn Toolchain gcc() {
    return (GCC){};
}

fn none GCC.plan_library(GCC *self, build::Build *build, Library *library) {
    ...
}

fn none GCC.plan_executable(GCC *self, build::Build *build, Executable *executable) {
    ...
}

@export
fn Toolchain clang() {
    return (Clang){};
}

fn none Clang.plan_library(Clang *self, build::Build *build, Library *library) {
    ...
}

fn none Clang.plan_executable(Clang *self, build::Build *build, Executable *executable) {
    ...
}

@export
type Library: Target = struct {
    build::Project *project;
    string name;

    DynArray<string> sources;
    DynArray<dyn build::Target *> dependencies;
    DynArray<string> outputs;
};

@export
type Executable: Target = struct {
    build::Project *project;
    string name;

    DynArray<string> sources;
    DynArray<dyn build::Target *> dependencies;
    DynArray<string> outputs;
};

@export
fn Library *library(build::Project *project, string name) {
    Library *library = project.arena.alloc<Library>();

    *library = {
        .project = project,
        .name = name,
        .sources = .create(project.arena),
        .dependencies = .create(project.arena),
        .outputs = .create(project.arena),
    };

    library.outputs.push(string::concat("build/lib", name, ".a", project.arena));

    project.add_target(library);
    return library;
}

@export
fn Executable *executable(build::Project *project, string name) {
    Executable *executable = project.arena.alloc<Executable>();

    *executable = {
        .project = project,
        .name = name,
        .sources = .create(project.arena),
        .dependencies = .create(project.arena),
        .outputs = .create(project.arena),
    };

    executable.outputs.push(string::concat("build/", name, project.arena));

    project.add_target(executable);
    return executable;
}

@export
fn Library *Library.sources(Library *self, string[] sources) {
    self.sources = .from_splice(sources);
    return self;
}

@export
fn Library *Library.depend(Library *self, dyn build::Target *dependency) {
    self.dependencies.push(dependency);
    return self;
}

@export
fn Library *Library.output(Library *self, string output) {
    self.outputs = .from_splice({ output });
    return self;
}

@export
fn Executable *Executable.sources(Executable *self, string[] sources) {
    self.sources = .from_splice(sources);
    return self;
}

@export
fn Executable *Executable.depend(Executable *self, dyn build::Target *dependency) {
    self.dependencies.push(dependency);
    return self;
}

@export
fn Executable *Executable.output(Executable *self, string output) {
    self.outputs = .from_splice({ output });
    return self;
}

fn none Library.plan(Library *self, build::Build *build) {
    Profile *profile = coda_profile(build);
    profile.toolchain.plan_library(build, self);
}

fn none Executable.plan(Executable *self, build::Build *build) {
    Profile *profile = coda_profile(build);
    profile.toolchain.plan_executable(build, self);
}

@export
fn Profile *debug(build::Project *project) {
    return profile(project, "debug")
        .toolchain(gcc());
}

@export
fn Profile *release(build::Project *project) {
    return profile(project, "release")
        .toolchain(clang());
}

@export
fn Executable *default(build::Project *project) {
    debug(project);
    release(project);

    return executable(project, project.name)
        .sources({"src/**/*.coda"});
}